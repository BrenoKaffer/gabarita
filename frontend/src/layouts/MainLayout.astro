---
import '../styles/globals.css';
const { title = 'Gabarita', showNav = true } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · Gabarita</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <meta name="theme-color" content="#b9ff66" />
</head>
<body class="bg-offwhite">

{showNav ? (
  <div class="flex h-screen overflow-hidden">

    <!-- ── Sidebar ── -->
    <aside id="sidebar"
      class="w-64 bg-dark flex flex-col fixed inset-y-0 left-0 z-40 transition-transform duration-300 -translate-x-full lg:translate-x-0">

      <!-- Logo -->
      <div class="px-4 py-4 border-b border-white/10">
        <a href="/home">
          <img src="/logo_gabarita_escuro.png" alt="Gabarita" class="h-12 w-auto" style="mix-blend-mode:lighten" />
        </a>
      </div>

      <!-- Mini stats card -->
      <div class="mx-3 mt-3 rounded-xl bg-white/8 border border-white/10 px-3 py-2.5">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-white/50 text-xs">Aproveitamento</span>
          <span id="sb-pct" class="text-green text-xs font-semibold">—%</span>
        </div>
        <div class="h-1.5 rounded-full bg-white/10 overflow-hidden">
          <div id="sb-bar" class="h-full bg-green rounded-full transition-all duration-500" style="width:0%"></div>
        </div>
        <div class="flex justify-between mt-1.5 text-white/35 text-[10px]">
          <span id="sb-resp">0 respondidas</span>
          <span id="sb-acc">0 acertos</span>
        </div>
      </div>

      <!-- Nav -->
      <nav class="flex-1 px-3 py-3 flex flex-col gap-0.5 overflow-y-auto">
        <a href="/home" data-nav="home" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Início
        </a>
        <a href="/cursos" data-nav="cursos" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 7v-6.5M3.27 6.96l8.73 4.88 8.73-4.88"/>
          </svg>
          Cursos
        </a>
        <a href="/study" data-nav="study" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          Revisão
        </a>
        <a href="/simulado" data-nav="simulado" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Simulado
        </a>
        <a href="/erros" data-nav="erros" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Erros
        </a>
        <a href="/stats" data-nav="stats" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          Estatísticas
        </a>

        <a href="/plano" data-nav="plano" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Plano
        </a>
        <a href="/flashcards" data-nav="flashcards" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          Flashcards
        </a>
        <a href="/importar" data-nav="importar" class="sidebar-link">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          Importar
        </a>

        <!-- Concursos (dinâmico) -->
        <div class="mt-3 pt-3 border-t border-white/10">
          <p class="text-white/25 text-[10px] uppercase tracking-widest px-3 mb-1.5">Concursos</p>
          <div id="concursos-sidebar"></div>
        </div>
      </nav>

      <!-- User -->
      <div class="px-3 py-3 border-t border-white/10">
        <div class="flex items-center gap-2.5">
          <div id="sidebar-avatar"
            class="w-8 h-8 rounded-full bg-green flex items-center justify-center text-dark font-bold text-sm shrink-0">
            B
          </div>
          <div class="flex-1 min-w-0">
            <p id="sidebar-name" class="text-white text-sm font-medium truncate">…</p>
            <p class="text-white/35 text-[10px]">Estudante</p>
          </div>
          <button id="btn-logout" title="Sair"
            class="p-1.5 rounded text-white/30 hover:text-white hover:bg-white/10 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-dark/50 z-30 hidden lg:hidden"></div>

    <!-- ── Main area ── -->
    <div class="flex-1 flex flex-col min-h-screen lg:pl-64">

      <!-- Header -->
      <header class="h-14 bg-white border-b border-dark/10 flex items-center justify-between px-4 sm:px-6 sticky top-0 z-20">

        <div class="flex items-center gap-3">
          <!-- Hamburger mobile -->
          <button id="btn-menu" class="p-1.5 rounded text-dark hover:bg-dark/5 lg:hidden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <!-- Breadcrumb -->
          <div class="flex items-center gap-2 text-sm">
            <span class="text-dark/40 hidden sm:block">Gabarita</span>
            <span class="text-dark/30 hidden sm:block">/</span>
            <span class="font-semibold text-dark">{title}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Countdown -->
          <div id="countdown-chip"
            class="hidden sm:flex items-center gap-1.5 bg-dark/5 rounded-full px-3 py-1 text-xs font-medium text-dark/70">
            <span class="w-1.5 h-1.5 rounded-full bg-green"></span>
            <span id="countdown-text">…</span>
          </div>

          <!-- Divider -->
          <div class="w-px h-5 bg-dark/10"></div>

          <!-- Notificações -->
          <div class="relative" id="notif-wrap">
            <button id="btn-notif" class="relative p-1.5 rounded text-dark/50 hover:text-dark hover:bg-dark/5 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
              <span id="notif-badge"
                class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-green text-dark text-[9px] font-bold rounded-full items-center justify-center hidden flex">
                0
              </span>
            </button>
            <!-- Dropdown -->
            <div id="notif-dropdown"
              class="hidden absolute right-0 mt-2 w-76 bg-white border border-dark/10 rounded-card shadow-card z-50 overflow-hidden" style="width:300px">
              <div class="px-4 py-2.5 border-b border-dark/10 flex items-center justify-between">
                <span class="font-semibold text-sm">Notificações</span>
                <button id="btn-mark-read" class="text-xs text-dark/40 hover:text-dark">Limpar</button>
              </div>
              <div id="notif-list" class="max-h-64 overflow-y-auto divide-y divide-dark/5">
                <div class="px-4 py-3 text-sm text-dark/40">Carregando…</div>
              </div>
            </div>
          </div>

          <!-- User chip -->
          <div class="flex items-center gap-2">
            <div id="header-avatar"
              class="w-8 h-8 rounded-full bg-green flex items-center justify-center text-dark font-bold text-sm shrink-0">
              B
            </div>
            <span id="header-name" class="text-sm font-medium text-dark hidden sm:block">Breno</span>
          </div>
        </div>
      </header>

      <!-- Content -->
      <main class="flex-1 p-4 sm:p-6 overflow-y-auto">
        <slot />
      </main>
    </div>
  </div>

) : (
  <slot />
)}

<style>
  .sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 8px;
    color: rgba(255,255,255,0.55); font-size: 0.875rem; font-weight: 500;
    transition: all 0.15s; text-decoration: none;
  }
  .sidebar-link:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .sidebar-link.active { background: #b9ff66; color: #191a23; }
  .sidebar-info {
    display: flex; align-items: flex-start; gap: 8px; padding: 5px 10px;
  }
</style>

<script>
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});

  const token = localStorage.getItem('gab_token');
  const user  = JSON.parse(localStorage.getItem('gab_user') || '{}');
  const path  = location.pathname;

  if (!token && !path.startsWith('/login') && !path.startsWith('/register')) {
    location.href = '/login';
  }

  // User info
  if (token && user.name) {
    const initials = user.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
    const first    = user.name.split(' ')[0];
    ['sidebar-name', 'header-name'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = first;
    });
    ['sidebar-avatar', 'header-avatar'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = initials;
    });
  }

  // Logout
  document.getElementById('btn-logout')?.addEventListener('click', () => {
    localStorage.removeItem('gab_token');
    localStorage.removeItem('gab_user');
    location.href = '/login';
  });

  // Active nav link
  const seg = location.pathname.replace(/^\//, '').split('/')[0];
  document.querySelectorAll('[data-nav]').forEach(el => {
    if ((el as HTMLElement).dataset.nav === seg) el.classList.add('active');
  });

  // Mobile sidebar
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  document.getElementById('btn-menu')?.addEventListener('click', () => {
    sidebar?.classList.toggle('-translate-x-full');
    overlay?.classList.toggle('hidden');
  });
  overlay?.addEventListener('click', () => {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
  });

  // ── Concursos dinâmicos ──
  async function loadConcursos() {
    try {
      const res = await fetch('/api/concursos');
      if (!res.ok) return;
      const list = await res.json();
      const today = new Date(); today.setHours(0, 0, 0, 0);

      function daysTo(dateStr: string): number {
        if (!dateStr) return Infinity;
        const t = new Date(dateStr + 'T12:00:00');
        return Math.ceil((t.getTime() - today.getTime()) / 86400000);
      }

      const sb = document.getElementById('concursos-sidebar');
      if (sb) {
        sb.innerHTML = list.map((c: any) => {
          const d = daysTo(c.data_prova);
          const dStr = isFinite(d) ? `${d}d` : '';
          const dateStr = c.data_prova
            ? new Date(c.data_prova + 'T12:00:00').toLocaleDateString('pt-BR')
            : '';
          return `<div class="sidebar-info">
            <span class="w-1.5 h-1.5 rounded-full shrink-0 mt-1.5" style="background:${c.cor || '#b9ff66'}"></span>
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <p class="text-white/80 text-xs font-medium">${c.nome}</p>
                <span class="text-[10px] font-semibold" style="color:${c.cor || '#b9ff66'}">${dStr}</span>
              </div>
              ${dateStr ? `<p class="text-white/35 text-[10px]">${dateStr}</p>` : ''}
            </div>
          </div>`;
        }).join('');
      }

      const ctEl = document.getElementById('countdown-text');
      if (ctEl && list.length > 0) {
        const nearest = list.reduce((best: any, c: any) =>
          daysTo(c.data_prova) < daysTo(best.data_prova) ? c : best);
        const d = daysTo(nearest.data_prova);
        ctEl.textContent = isFinite(d) ? `${d} dias · ${nearest.nome}` : nearest.nome;
      }
    } catch {}
  }
  loadConcursos();

  // ── Sidebar stats ──
  async function loadSidebarStats() {
    if (!token) return;
    try {
      const res = await fetch('/api/stats', { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) return;
      const { overall } = await res.json();
      const pct = overall?.respondidas
        ? Math.round((overall.acertos / overall.respondidas) * 100) : 0;
      document.getElementById('sb-pct')!.textContent  = pct + '%';
      document.getElementById('sb-bar')!.style.width  = pct + '%';
      document.getElementById('sb-resp')!.textContent = `${overall?.respondidas || 0} respondidas`;
      document.getElementById('sb-acc' )!.textContent = `${overall?.acertos || 0} acertos`;
    } catch {}
  }

  // ── Notifications ──
  async function loadNotifications() {
    if (!token) return;
    try {
      const res = await fetch('/api/stats', { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) return;
      const { overall, errors } = await res.json();
      const notifs: Array<{type: string; text: string; href: string}> = [];

      if (errors?.length > 0)
        notifs.push({ type: 'warn', text: `${errors.length} questão(ões) para revisar`, href: '/erros' });

      const pct = overall?.respondidas
        ? Math.round((overall.acertos / overall.respondidas) * 100) : 0;
      if (overall?.respondidas >= 10 && pct < 60)
        notifs.push({ type: 'warn', text: `Aproveitamento ${pct}% — reforce os pontos fracos`, href: '/stats' });

      notifs.push({ type: 'info', text: `CGU em ${cgDays} dias — 13/12/2026`, href: '/home' });
      notifs.push({ type: 'info', text: `SETEC em ${setecDays} dias — 17/01/2027`, href: '/home' });

      const badge  = document.getElementById('notif-badge');
      const unread = notifs.filter(n => n.type === 'warn').length;
      if (badge && unread > 0) {
        badge.textContent = String(unread);
        badge.classList.remove('hidden');
        badge.classList.add('flex');
      }

      const list = document.getElementById('notif-list');
      if (list) list.innerHTML = notifs.map(n => `
        <a href="${n.href}" class="flex items-start gap-3 px-4 py-3 hover:bg-dark/5 transition-colors">
          <span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0 ${n.type === 'warn' ? 'bg-yellow-400' : 'bg-green'}"></span>
          <span class="text-sm text-dark">${n.text}</span>
        </a>
      `).join('');
    } catch {}
  }

  document.getElementById('btn-notif')?.addEventListener('click', e => {
    e.stopPropagation();
    document.getElementById('notif-dropdown')?.classList.toggle('hidden');
  });
  document.addEventListener('click', () =>
    document.getElementById('notif-dropdown')?.classList.add('hidden'));
  document.getElementById('btn-mark-read')?.addEventListener('click', () =>
    document.getElementById('notif-badge')?.classList.add('hidden'));

  loadSidebarStats();
  loadNotifications();
</script>
</body>
</html>
