---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Cursos">

<style>
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .course-card {
    background: white;
    border: 1.5px solid #191a23;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0px 4px 0px #191a23;
    cursor: pointer;
    text-decoration: none;
    display: block;
    transition: transform 0.15s;
  }
  .course-card:hover { transform: translateY(-2px); }
  .card-top {
    height: 76px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.75rem; font-weight: 700;
    color: rgba(255,255,255,0.9); letter-spacing: -0.02em;
  }
  .card-body { padding: 0.875rem 1rem 1rem; }
  .card-title { font-size: 0.9375rem; font-weight: 600; color: #191a23; margin-bottom: 0.2rem; }
  .card-desc {
    font-size: 0.8125rem; color: rgba(25,26,35,0.45); line-height: 1.5;
    margin-bottom: 0.75rem; min-height: 2.4em;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-meta { font-size: 0.72rem; color: rgba(25,26,35,0.35); margin-bottom: 0.6rem; }
  .prog-wrap { height: 4px; background: rgba(25,26,35,0.07); border-radius: 2px; overflow: hidden; }
  .prog-fill { height: 100%; background: #b9ff66; border-radius: 2px; transition: width 0.4s; }

  /* Modal */
  .overlay {
    position: fixed; inset: 0; background: rgba(25,26,35,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 100; padding: 1rem;
  }
  .modal {
    background: white; border-radius: 20px; padding: 1.75rem;
    width: 100%; max-width: 440px;
    border: 1.5px solid #191a23; box-shadow: 0px 8px 0px #191a23;
  }
  .color-dot {
    width: 30px; height: 30px; border-radius: 50%;
    border: 2.5px solid transparent; cursor: pointer;
    transition: transform 0.15s, border-color 0.15s;
  }
  .color-dot.sel { border-color: #191a23; transform: scale(1.18); }
</style>

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-semibold">Meus Cursos</h1>
    <p class="text-dark/45 text-sm mt-0.5">Organize o conhecimento em cursos e aulas</p>
  </div>
  <button id="btn-novo" class="btn-primary flex items-center gap-2 text-sm">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    Novo Curso
  </button>
</div>

<!-- Empty state -->
<div id="empty-state" class="hidden flex-col items-center py-20 text-center">
  <div class="w-16 h-16 bg-dark/5 rounded-2xl flex items-center justify-center mb-4">
    <svg class="w-8 h-8 text-dark/25" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>
  </div>
  <p class="text-dark/55 font-medium mb-1">Nenhum curso ainda</p>
  <p class="text-dark/35 text-sm">Crie seu primeiro curso para começar</p>
</div>

<!-- Grid -->
<div id="grid" class="courses-grid"></div>

<!-- Modal -->
<div id="overlay" class="overlay hidden">
  <div class="modal">
    <h2 class="text-lg font-semibold mb-4">Novo Curso</h2>
    <div class="flex flex-col gap-4">
      <div>
        <label class="text-sm font-medium mb-1.5 block">Título <span class="text-red-400">*</span></label>
        <input id="inp-titulo" type="text" class="input" placeholder="Ex: Raciocínio Lógico do Zero" />
      </div>
      <div>
        <label class="text-sm font-medium mb-1.5 block">Descrição <span class="text-dark/30 font-normal">(opcional)</span></label>
        <textarea id="inp-desc" class="input resize-none" rows="2" placeholder="Breve descrição do conteúdo…"></textarea>
      </div>
      <div>
        <label class="text-sm font-medium mb-2 block">Cor</label>
        <div class="flex gap-2 flex-wrap" id="color-picker">
          <button class="color-dot sel" data-c="#6366f1" style="background:#6366f1" title="Índigo"></button>
          <button class="color-dot" data-c="#0ea5e9" style="background:#0ea5e9" title="Azul"></button>
          <button class="color-dot" data-c="#10b981" style="background:#10b981" title="Verde"></button>
          <button class="color-dot" data-c="#f59e0b" style="background:#f59e0b" title="Âmbar"></button>
          <button class="color-dot" data-c="#ef4444" style="background:#ef4444" title="Vermelho"></button>
          <button class="color-dot" data-c="#8b5cf6" style="background:#8b5cf6" title="Roxo"></button>
          <button class="color-dot" data-c="#191a23" style="background:#191a23" title="Escuro"></button>
        </div>
      </div>
    </div>
    <div class="flex gap-2 mt-6">
      <button id="btn-cancel" class="btn-secondary flex-1 text-sm">Cancelar</button>
      <button id="btn-criar" class="btn-primary flex-1 text-sm">Criar</button>
    </div>
  </div>
</div>

<script>
  const token = localStorage.getItem('gab_token');

  function initials(t: string) {
    return t.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
  }

  async function load() {
    const res = await fetch('/api/cursos', { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) return;
    const cursos = await res.json();

    const grid  = document.getElementById('grid')!;
    const empty = document.getElementById('empty-state')!;

    if (!cursos.length) { empty.style.display = 'flex'; return; }

    grid.innerHTML = cursos.map((c: any) => {
      const pct = c.total_aulas > 0 ? Math.round(c.aulas_concluidas / c.total_aulas * 100) : 0;
      return `
        <a href="/curso?id=${c.id}" class="course-card">
          <div class="card-top" style="background:${c.cor || '#6366f1'}">${initials(c.titulo)}</div>
          <div class="card-body">
            <div class="card-title">${c.titulo}</div>
            <div class="card-desc">${c.descricao || '<em>Sem descrição</em>'}</div>
            <div class="card-meta">${c.total_modulos} módulo${c.total_modulos !== 1 ? 's' : ''} · ${c.total_aulas} aula${c.total_aulas !== 1 ? 's' : ''}</div>
            <div class="prog-wrap"><div class="prog-fill" style="width:${pct}%"></div></div>
          </div>
        </a>`;
    }).join('');
  }

  // ── Modal ──
  let cor = '#6366f1';
  const overlay  = document.getElementById('overlay')!;
  const btnNovo  = document.getElementById('btn-novo')!;
  const btnCancel = document.getElementById('btn-cancel')!;
  const btnCriar = document.getElementById('btn-criar')!;

  btnNovo.addEventListener('click', () => overlay.classList.remove('hidden'));
  btnCancel.addEventListener('click', () => overlay.classList.add('hidden'));
  overlay.addEventListener('click', e => { if (e.target === overlay) overlay.classList.add('hidden'); });

  document.getElementById('color-picker')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.color-dot');
    if (!btn) return;
    document.querySelectorAll('.color-dot').forEach(el => el.classList.remove('sel'));
    btn.classList.add('sel');
    cor = btn.dataset.c!;
  });

  btnCriar.addEventListener('click', async () => {
    const titulo = (document.getElementById('inp-titulo') as HTMLInputElement).value.trim();
    const descricao = (document.getElementById('inp-desc') as HTMLTextAreaElement).value.trim();
    if (!titulo) { (document.getElementById('inp-titulo') as HTMLInputElement).focus(); return; }

    btnCriar.textContent = 'Criando…';
    (btnCriar as HTMLButtonElement).disabled = true;

    const res = await fetch('/api/cursos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo, descricao, cor }),
    });

    btnCriar.textContent = 'Criar';
    (btnCriar as HTMLButtonElement).disabled = false;

    if (res.ok) {
      const { id } = await res.json();
      location.href = `/curso?id=${id}`;
    }
  });

  load();
</script>
</MainLayout>
