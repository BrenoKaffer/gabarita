---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Cursos">

<style is:global>
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .course-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(25,26,35,0.12), 0 1px 4px rgba(25,26,35,0.08);
    cursor: pointer; text-decoration: none; display: flex; flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .course-card:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 12px 32px rgba(25,26,35,0.18), 0 2px 8px rgba(25,26,35,0.1);
  }

  /* Capa: 16:9 na vertical (9:16), bem alta */
  .card-cover {
    aspect-ratio: 9 / 16;
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    flex-shrink: 0;
  }
  .card-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card-cover-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 35%, rgba(0,0,0,0.78) 100%);
  }
  .card-cover-body {
    position: relative; padding: 1rem 0.875rem 0.875rem;
    width: 100%;
  }
  .card-cover-title {
    font-size: 1rem; font-weight: 700; line-height: 1.25;
    color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,0.5);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-cover-meta {
    font-size: 0.7rem; font-weight: 500;
    color: rgba(255,255,255,0.6); letter-spacing: 0.01em;
    margin-top: 0.3rem;
  }

  /* Modal */
  .overlay { position: fixed; inset: 0; background: rgba(25,26,35,0.5); display: none; align-items: center; justify-content: center; z-index: 100; padding: 1rem; overflow-y: auto; }
  .overlay.show { display: flex; }
  .modal { background: white; border-radius: 20px; padding: 1.75rem; width: 100%; max-width: 440px; border: 1.5px solid #191a23; box-shadow: 0px 8px 0px #191a23; transition: max-width 0.25s; }
  .modal.wide { max-width: 680px; }
  .color-dot { width: 24px; height: 24px; border-radius: 50%; border: 2.5px solid transparent; cursor: pointer; transition: transform 0.15s, border-color 0.15s; flex-shrink: 0; }
  .color-dot.sel { border-color: #191a23; transform: scale(1.18); }
  .upload-zone { border: 2px dashed rgba(25,26,35,0.15); border-radius: 14px; padding: 1.25rem; text-align: center; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .upload-zone:hover, .upload-zone.drag { border-color: #6366f1; background: rgba(99,102,241,0.04); }
  .capa-preview { height: 90px; border-radius: 10px; overflow: hidden; margin-bottom: 0.5rem; display: none; }
  .capa-preview img { width: 100%; height: 100%; object-fit: cover; }

  /* Modo tabs */
  .modo-tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
  .modo-tab { flex: 1; padding: 0.6rem; border-radius: 12px; border: 1.5px solid rgba(25,26,35,0.12); font-size: 0.8rem; font-weight: 600; cursor: pointer; background: none; text-align: center; transition: all 0.15s; color: rgba(25,26,35,0.5); }
  .modo-tab.active { border-color: #191a23; background: #191a23; color: #b9ff66; }
  .modo-tab:hover:not(.active) { border-color: rgba(25,26,35,0.3); color: #191a23; }

  /* Preview */
  .preview-list { max-height: 50vh; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; }
  .preview-mod { border: 1.5px solid rgba(25,26,35,0.1); border-radius: 12px; overflow: hidden; }
  .preview-mod-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.75rem; background: rgba(25,26,35,0.02); }
  .preview-mod-title { flex: 1; font-size: 0.875rem; font-weight: 600; border: none; background: none; outline: none; color: #191a23; }
  .preview-mod-title:focus { background: rgba(25,26,35,0.04); border-radius: 6px; padding: 2px 4px; }
  .preview-aula { display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.75rem; border-top: 1px solid rgba(25,26,35,0.06); }
  .preview-aula-title { flex: 1; font-size: 0.8125rem; border: none; background: none; outline: none; color: rgba(25,26,35,0.7); }
  .preview-aula-title:focus { background: rgba(25,26,35,0.04); border-radius: 6px; padding: 2px 4px; color: #191a23; }
  .del-btn { padding: 3px; border-radius: 6px; background: none; border: none; cursor: pointer; color: rgba(25,26,35,0.2); transition: all 0.1s; flex-shrink: 0; }
  .del-btn:hover { color: #ef4444; background: rgba(239,68,68,0.08); }

  /* Loading spinner */
  .spinner { width: 32px; height: 32px; border: 3px solid rgba(25,26,35,0.1); border-top-color: #191a23; border-radius: 50%; animation: spin 0.7s linear infinite; margin: 0 auto; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-semibold">Meus Cursos</h1>
    <p class="text-dark/45 text-sm mt-0.5">Organize o conhecimento em cursos e aulas</p>
  </div>
  <button id="btn-novo" class="btn-primary flex items-center gap-2 text-sm">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    Novo Curso
  </button>
</div>

<!-- Empty state -->
<div id="empty-state" class="hidden flex-col items-center py-20 text-center">
  <div class="w-16 h-16 bg-dark/5 rounded-2xl flex items-center justify-center mb-4">
    <svg class="w-8 h-8 text-dark/25" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>
  </div>
  <p class="text-dark/55 font-medium mb-1">Nenhum curso ainda</p>
  <p class="text-dark/35 text-sm">Crie seu primeiro curso para começar</p>
</div>

<!-- Grid -->
<div id="grid" class="courses-grid"></div>

<!-- Modal -->
<div id="overlay" class="overlay">
  <div class="modal" id="modal-box">

    <!-- STEP: modo -->
    <div id="step-modo">
      <h2 class="text-lg font-semibold mb-4">Novo Curso</h2>
      <div class="modo-tabs">
        <button class="modo-tab active" data-m="manual">✏️ Manual</button>
        <button class="modo-tab" data-m="pdf">📄 PDF do Programa</button>
        <button class="modo-tab" data-m="json">{ } JSON</button>
      </div>

      <!-- Manual -->
      <div id="form-manual" class="flex flex-col gap-4">
        <div>
          <label class="text-sm font-medium mb-1.5 block">Título <span class="text-red-400">*</span></label>
          <input id="inp-titulo" type="text" class="input" placeholder="Ex: Cálculo I" />
        </div>
        <div>
          <label class="text-sm font-medium mb-1.5 block">Descrição <span class="text-dark/30 font-normal">(opcional)</span></label>
          <textarea id="inp-desc" class="input resize-none" rows="2" placeholder="Breve descrição…"></textarea>
        </div>
        <div>
          <label class="text-sm font-medium mb-2 block">Capa do curso</label>
          <div class="capa-preview" id="capa-preview"><img id="capa-img" src="" alt="" /></div>
          <div class="upload-zone" id="upload-zone">
            <input type="file" id="inp-capa" accept="image/*" class="hidden" />
            <svg class="w-7 h-7 text-dark/20 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M13.5 12h.008v.008H13.5V12zm-6 3h12a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75v8.25A2.25 2.25 0 004.5 15.75h3z"/>
            </svg>
            <p id="upload-label" class="text-sm text-dark/40">Clique ou arraste uma imagem</p>
            <p class="text-xs text-dark/25 mt-0.5">JPG, PNG, WEBP · redimensionado automaticamente</p>
          </div>
          <div class="flex items-center gap-2 mt-2.5">
            <span class="text-xs text-dark/40 shrink-0">Cor (sem imagem):</span>
            <div class="flex gap-1.5 flex-wrap" id="color-picker">
              <button class="color-dot sel" data-c="#6366f1" style="background:#6366f1" title="Índigo"></button>
              <button class="color-dot" data-c="#0ea5e9" style="background:#0ea5e9" title="Azul"></button>
              <button class="color-dot" data-c="#10b981" style="background:#10b981" title="Verde"></button>
              <button class="color-dot" data-c="#f59e0b" style="background:#f59e0b" title="Âmbar"></button>
              <button class="color-dot" data-c="#ef4444" style="background:#ef4444" title="Vermelho"></button>
              <button class="color-dot" data-c="#8b5cf6" style="background:#8b5cf6" title="Roxo"></button>
              <button class="color-dot" data-c="#191a23" style="background:#191a23" title="Escuro"></button>
            </div>
          </div>
        </div>
        <div class="flex gap-2 mt-2">
          <button id="btn-cancel" class="btn-secondary flex-1 text-sm">Cancelar</button>
          <button id="btn-criar-manual" class="btn-primary flex-1 text-sm">Criar</button>
        </div>
      </div>

      <!-- PDF -->
      <div id="form-pdf" class="hidden flex-col gap-4">
        <p class="text-sm text-dark/55">Envie o PDF do plano de ensino/programa da disciplina. A IA vai extrair os módulos, aulas e datas das provas automaticamente.</p>
        <div class="upload-zone" id="pdf-zone">
          <input type="file" id="inp-pdf" accept=".pdf" class="hidden" />
          <svg class="w-8 h-8 text-dark/20 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
          <p id="pdf-label" class="text-sm text-dark/40">Clique ou arraste o PDF</p>
          <p class="text-xs text-dark/25 mt-0.5">Máx 20 MB · PDF com texto (não escaneado)</p>
        </div>
        <div id="pdf-error" class="hidden text-sm text-red-600 bg-red-50 rounded-btn px-3 py-2"></div>
        <div class="flex gap-2">
          <button id="btn-cancel-pdf" class="btn-secondary flex-1 text-sm">Cancelar</button>
          <button id="btn-gerar-pdf" class="btn-primary flex-1 text-sm" disabled>Gerar estrutura →</button>
        </div>
      </div>

      <!-- JSON -->
      <div id="form-json" class="hidden flex-col gap-4">
        <p class="text-sm text-dark/55">Cole o JSON com o conteúdo programático gerado por qualquer IA. A plataforma vai normalizar e gerar a estrutura de módulos.</p>
        <div>
          <label class="text-sm font-medium mb-1.5 block">JSON do conteúdo</label>
          <textarea id="inp-json" class="input font-mono text-xs resize-none" rows="8" placeholder='{"disciplinas": [{"nome": "SQL", "topicos": [...]}]}'></textarea>
        </div>
        <div id="json-error" class="hidden text-sm text-red-600 bg-red-50 rounded-btn px-3 py-2"></div>
        <div class="flex gap-2">
          <button id="btn-cancel-json" class="btn-secondary flex-1 text-sm">Cancelar</button>
          <button id="btn-gerar-json" class="btn-primary flex-1 text-sm">Gerar estrutura →</button>
        </div>
      </div>
    </div>

    <!-- STEP: loading -->
    <div id="step-loading" class="hidden text-center py-8">
      <div class="spinner mb-4"></div>
      <p class="font-medium text-sm">Analisando com IA…</p>
      <p class="text-xs text-dark/40 mt-1">Isso pode levar alguns segundos</p>
    </div>

    <!-- STEP: preview -->
    <div id="step-preview" class="hidden">
      <div class="flex items-center gap-2 mb-4">
        <button id="btn-voltar-preview" class="text-dark/40 hover:text-dark transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <h2 class="text-lg font-semibold flex-1">Revisar estrutura</h2>
        <span id="preview-count" class="text-xs text-dark/35"></span>
      </div>

      <div class="flex flex-col gap-3 mb-4">
        <div>
          <label class="text-xs font-semibold text-dark/40 uppercase tracking-wide block mb-1">Título do curso</label>
          <input id="preview-titulo" type="text" class="input text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-dark/40 uppercase tracking-wide block mb-1">Descrição</label>
          <input id="preview-desc" type="text" class="input text-sm" placeholder="Opcional" />
        </div>
        <div id="preview-provas-wrap" class="hidden">
          <label class="text-xs font-semibold text-dark/40 uppercase tracking-wide block mb-1">Datas extraídas</label>
          <div id="preview-provas" class="flex flex-col gap-1 text-sm"></div>
        </div>
      </div>

      <label class="text-xs font-semibold text-dark/40 uppercase tracking-wide block mb-2">Módulos e aulas <span class="font-normal normal-case">(clique para editar)</span></label>
      <div id="preview-list" class="preview-list mb-4"></div>

      <div id="preview-error" class="hidden text-sm text-red-600 bg-red-50 rounded-btn px-3 py-2 mb-3"></div>
      <div class="flex gap-2">
        <button id="btn-cancel-preview" class="btn-secondary flex-1 text-sm">Cancelar</button>
        <button id="btn-criar-preview" class="btn-primary flex-1 text-sm">Criar curso</button>
      </div>
    </div>

  </div>
</div>

<script>
  const token = localStorage.getItem('gab_token');

  function initials(t: string) {
    return t.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
  }

  async function load() {
    const res = await fetch('/api/cursos', { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) return;
    const cursos = await res.json();
    const grid  = document.getElementById('grid')!;
    const empty = document.getElementById('empty-state')!;
    if (!cursos.length) { empty.style.display = 'flex'; return; }

    grid.innerHTML = cursos.map((c: any) => {
      const coverBg = c.capa_base64
        ? `background:#111`
        : `background:${c.cor || '#6366f1'}`;
      const coverImg = c.capa_base64
        ? `<img class="card-cover-img" src="${c.capa_base64}" alt="" />`
        : '';
      const meta = `${c.total_modulos} módulo${c.total_modulos !== 1 ? 's' : ''} · ${c.total_aulas} aula${c.total_aulas !== 1 ? 's' : ''}`;
      return `<a href="/curso?id=${c.id}" class="course-card">
        <div class="card-cover" style="${coverBg}">
          ${coverImg}
          <div class="card-cover-overlay"></div>
          <div class="card-cover-body">
            <div class="card-cover-title">${c.titulo}</div>
            <div class="card-cover-meta">${meta}</div>
          </div>
        </div>
      </a>`;
    }).join('');
  }

  // ── Estado do modal ──
  let cor = '#6366f1';
  let capaBase64: string | null = null;
  let modo = 'manual';
  let pdfFile: File | null = null;
  let estruturaGerada: any = null;

  const overlay   = document.getElementById('overlay')!;
  const modalBox  = document.getElementById('modal-box')!;

  function showStep(id: string) {
    ['step-modo','step-loading','step-preview'].forEach(s => {
      (document.getElementById(s) as HTMLElement).classList.add('hidden');
    });
    (document.getElementById(id) as HTMLElement).classList.remove('hidden');
    modalBox.classList.toggle('wide', id === 'step-preview');
  }

  function closeModal() {
    overlay.classList.remove('show');
    pdfFile = null; estruturaGerada = null; capaBase64 = null;
    (document.getElementById('inp-titulo') as HTMLInputElement).value = '';
    (document.getElementById('inp-desc') as HTMLTextAreaElement).value = '';
    (document.getElementById('inp-json') as HTMLTextAreaElement).value = '';
    (document.getElementById('pdf-label') as HTMLElement).textContent = 'Clique ou arraste o PDF';
    (document.getElementById('btn-gerar-pdf') as HTMLButtonElement).disabled = true;
    (document.getElementById('capa-preview') as HTMLElement).style.display = 'none';
    (document.getElementById('upload-label') as HTMLElement).textContent = 'Clique ou arraste uma imagem';
    (document.getElementById('pdf-error') as HTMLElement).classList.add('hidden');
    (document.getElementById('json-error') as HTMLElement).classList.add('hidden');
    showStep('step-modo');
  }

  // Abrir modal
  document.getElementById('btn-novo')!.addEventListener('click', () => {
    overlay.classList.add('show');
    showStep('step-modo');
  });
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });

  // Cancelar buttons
  ['btn-cancel','btn-cancel-pdf','btn-cancel-json','btn-cancel-preview'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', closeModal);
  });

  // Voltar do preview
  document.getElementById('btn-voltar-preview')!.addEventListener('click', () => showStep('step-modo'));

  // ── Tabs de modo ──
  document.querySelectorAll<HTMLButtonElement>('.modo-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.modo-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      modo = tab.dataset.m!;
      ['form-manual','form-pdf','form-json'].forEach(f => {
        (document.getElementById(f) as HTMLElement).classList.add('hidden');
      });
      (document.getElementById(`form-${modo}`) as HTMLElement).classList.remove('hidden');
    });
  });

  // ── Cor ──
  document.getElementById('color-picker')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.color-dot');
    if (!btn) return;
    document.querySelectorAll('.color-dot').forEach(el => el.classList.remove('sel'));
    btn.classList.add('sel');
    cor = btn.dataset.c!;
  });

  // ── Image upload ──
  function compressImage(file: File): Promise<string> {
    return new Promise(resolve => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        const MAX = 800;
        let { width, height } = img;
        if (width > MAX) { height = Math.round(height * MAX / width); width = MAX; }
        const canvas = document.createElement('canvas');
        canvas.width = width; canvas.height = height;
        canvas.getContext('2d')!.drawImage(img, 0, 0, width, height);
        URL.revokeObjectURL(url);
        resolve(canvas.toDataURL('image/jpeg', 0.7));
      };
      img.src = url;
    });
  }
  async function processImage(file: File) {
    const b64 = await compressImage(file);
    capaBase64 = b64;
    (document.getElementById('capa-img') as HTMLImageElement).src = b64;
    (document.getElementById('capa-preview') as HTMLElement).style.display = 'block';
    (document.getElementById('upload-label') as HTMLElement).textContent = file.name;
  }
  const inpCapa = document.getElementById('inp-capa') as HTMLInputElement;
  const uploadZone = document.getElementById('upload-zone')!;
  uploadZone.addEventListener('click', () => inpCapa.click());
  uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('drag'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag'));
  uploadZone.addEventListener('drop', async (e: DragEvent) => {
    e.preventDefault(); uploadZone.classList.remove('drag');
    const file = e.dataTransfer?.files[0]; if (file) await processImage(file);
  });
  inpCapa.addEventListener('change', async () => { const file = inpCapa.files?.[0]; if (file) await processImage(file); });

  // ── PDF upload ──
  const inpPdf  = document.getElementById('inp-pdf') as HTMLInputElement;
  const pdfZone = document.getElementById('pdf-zone')!;
  const btnGerarPdf = document.getElementById('btn-gerar-pdf') as HTMLButtonElement;

  pdfZone.addEventListener('click', () => inpPdf.click());
  pdfZone.addEventListener('dragover', e => { e.preventDefault(); pdfZone.classList.add('drag'); });
  pdfZone.addEventListener('dragleave', () => pdfZone.classList.remove('drag'));
  pdfZone.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault(); pdfZone.classList.remove('drag');
    const file = e.dataTransfer?.files[0];
    if (file?.type === 'application/pdf') setPdfFile(file);
  });
  inpPdf.addEventListener('change', () => { if (inpPdf.files?.[0]) setPdfFile(inpPdf.files[0]); });

  function setPdfFile(file: File) {
    pdfFile = file;
    (document.getElementById('pdf-label') as HTMLElement).textContent = `📄 ${file.name}`;
    btnGerarPdf.disabled = false;
  }

  btnGerarPdf.addEventListener('click', async () => {
    if (!pdfFile) return;
    (document.getElementById('pdf-error') as HTMLElement).classList.add('hidden');
    showStep('step-loading');
    try {
      const form = new FormData();
      form.append('pdf', pdfFile);
      const res = await fetch('/api/importar-curso/pdf', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: form,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Erro ao processar PDF');
      estruturaGerada = data;
      renderPreview(data);
    } catch (err: any) {
      showStep('step-modo');
      (document.getElementById('pdf-error') as HTMLElement).textContent = err.message;
      (document.getElementById('pdf-error') as HTMLElement).classList.remove('hidden');
    }
  });

  // ── JSON geração ──
  document.getElementById('btn-gerar-json')!.addEventListener('click', async () => {
    const raw = (document.getElementById('inp-json') as HTMLTextAreaElement).value.trim();
    (document.getElementById('json-error') as HTMLElement).classList.add('hidden');
    let parsed: any;
    try { parsed = JSON.parse(raw); } catch {
      (document.getElementById('json-error') as HTMLElement).textContent = 'JSON inválido — verifique a sintaxe.';
      (document.getElementById('json-error') as HTMLElement).classList.remove('hidden');
      return;
    }
    showStep('step-loading');
    try {
      const res = await fetch('/api/importar-curso/json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ json: parsed }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Erro ao processar JSON');
      estruturaGerada = data;
      renderPreview(data);
    } catch (err: any) {
      showStep('step-modo');
      (document.getElementById('json-error') as HTMLElement).textContent = err.message;
      (document.getElementById('json-error') as HTMLElement).classList.remove('hidden');
    }
  });

  // ── Preview ──
  function renderPreview(e: any) {
    (document.getElementById('preview-titulo') as HTMLInputElement).value = e.titulo || '';
    (document.getElementById('preview-desc') as HTMLInputElement).value = e.descricao || '';

    // Datas das provas
    if (e.provas?.length) {
      const wrap = document.getElementById('preview-provas-wrap')!;
      wrap.classList.remove('hidden');
      document.getElementById('preview-provas')!.innerHTML = e.provas.map((p: any) =>
        `<div class="flex items-center gap-2 text-dark/60">
          <span class="text-xs px-2 py-0.5 rounded-full border ${p.status === 'confirmada' ? 'border-green-300 text-green-700 bg-green-50' : 'border-amber-300 text-amber-700 bg-amber-50'}">${p.status}</span>
          <span class="font-medium text-dark">${p.nome}</span>
          ${p.data ? `<span>· ${p.data}</span>` : ''}
          ${p.peso > 1 ? `<span class="text-xs">(peso ${p.peso})</span>` : ''}
        </div>`
      ).join('');
    } else {
      document.getElementById('preview-provas-wrap')!.classList.add('hidden');
    }

    // Módulos
    const list = document.getElementById('preview-list')!;
    const mods: any[] = e.modulos || [];
    const totalAulas = mods.reduce((s: number, m: any) => s + (m.aulas?.length || 0), 0);
    document.getElementById('preview-count')!.textContent = `${mods.length} módulo${mods.length !== 1 ? 's' : ''} · ${totalAulas} aula${totalAulas !== 1 ? 's' : ''}`;

    list.innerHTML = mods.map((m: any, mi: number) => `
      <div class="preview-mod" id="pmod-${mi}">
        <div class="preview-mod-header">
          <input class="preview-mod-title" value="${m.titulo}" data-mi="${mi}" />
          <button class="del-btn" onclick="delMod(${mi})" title="Remover módulo">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        ${(m.aulas || []).map((a: any, ai: number) => `
          <div class="preview-aula" id="paula-${mi}-${ai}">
            <span class="text-xs text-dark/20 shrink-0 font-mono w-5 text-right">${ai + 1}</span>
            <input class="preview-aula-title" value="${a.titulo}" data-mi="${mi}" data-ai="${ai}" />
            <button class="del-btn" onclick="delAula(${mi},${ai})" title="Remover aula">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>`).join('')}
      </div>`).join('');

    showStep('step-preview');
  }

  function readPreviewModulos(): any[] {
    const mods: any[] = [];
    document.querySelectorAll<HTMLInputElement>('.preview-mod-title').forEach(inp => {
      const mi = parseInt(inp.dataset.mi!);
      mods[mi] = { titulo: inp.value.trim(), aulas: [] };
    });
    document.querySelectorAll<HTMLInputElement>('.preview-aula-title').forEach(inp => {
      const mi = parseInt(inp.dataset.mi!);
      const ai = parseInt(inp.dataset.ai!);
      if (!mods[mi]) return;
      mods[mi].aulas[ai] = { titulo: inp.value.trim(), duracao_min: 50 };
    });
    return mods.filter(Boolean).map(m => ({ ...m, aulas: (m.aulas || []).filter(Boolean) }));
  }

  (window as any).delMod  = (mi: number) => document.getElementById(`pmod-${mi}`)?.remove();
  (window as any).delAula = (mi: number, ai: number) => document.getElementById(`paula-${mi}-${ai}`)?.remove();

  // ── Criar manual ──
  document.getElementById('btn-criar-manual')!.addEventListener('click', async () => {
    const titulo   = (document.getElementById('inp-titulo') as HTMLInputElement).value.trim();
    const descricao = (document.getElementById('inp-desc') as HTMLTextAreaElement).value.trim();
    if (!titulo) { (document.getElementById('inp-titulo') as HTMLInputElement).focus(); return; }
    const btn = document.getElementById('btn-criar-manual') as HTMLButtonElement;
    btn.textContent = 'Criando…'; btn.disabled = true;
    const res = await fetch('/api/cursos', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo, descricao, cor, capa_base64: capaBase64 }),
    });
    btn.textContent = 'Criar'; btn.disabled = false;
    if (res.ok) { const { id } = await res.json(); location.href = `/curso?id=${id}`; }
  });

  // ── Criar do preview ──
  document.getElementById('btn-criar-preview')!.addEventListener('click', async () => {
    const titulo   = (document.getElementById('preview-titulo') as HTMLInputElement).value.trim();
    const descricao = (document.getElementById('preview-desc') as HTMLInputElement).value.trim();
    if (!titulo) { (document.getElementById('preview-titulo') as HTMLInputElement).focus(); return; }
    const modulos = readPreviewModulos();
    if (!modulos.length) {
      const errEl = document.getElementById('preview-error')!;
      errEl.textContent = 'Adicione ao menos um módulo antes de criar.';
      errEl.classList.remove('hidden');
      return;
    }

    const btn = document.getElementById('btn-criar-preview') as HTMLButtonElement;
    btn.textContent = 'Criando…'; btn.disabled = true;

    const res = await fetch('/api/importar-curso/criar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo, descricao, cor: estruturaGerada?.cor || cor, modulos }),
    });
    btn.textContent = 'Criar curso'; btn.disabled = false;

    if (res.ok) { const { id } = await res.json(); location.href = `/curso?id=${id}`; }
    else {
      const errEl = document.getElementById('preview-error')!;
      errEl.textContent = 'Erro ao criar curso. Tente novamente.';
      errEl.classList.remove('hidden');
    }
  });

  load();
</script>
</MainLayout>
