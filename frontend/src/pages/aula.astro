---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Aula">

<style>
  #read-view { max-width: 740px; }

  #edit-view {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    height: calc(100vh - 230px);
    min-height: 420px;
  }
  #edit-view.show { display: grid; }
  @media (max-width: 768px) {
    #edit-view { grid-template-columns: 1fr; }
    #preview-pane { display: none !important; }
  }

  .pane {
    border: 1.5px solid rgba(25,26,35,0.1);
    border-radius: 16px;
    overflow: hidden;
    display: flex; flex-direction: column;
  }
  .pane-label {
    padding: 0.4rem 0.875rem;
    background: rgba(25,26,35,0.03);
    border-bottom: 1px solid rgba(25,26,35,0.07);
    font-size: 0.7rem; font-weight: 600;
    color: rgba(25,26,35,0.35);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  #md-ta {
    flex: 1; border: none; outline: none; resize: none;
    padding: 1rem; font-family: 'Fira Code', 'Courier New', monospace;
    font-size: 0.875rem; line-height: 1.65; color: #191a23;
    background: white;
  }
  #preview-pane { flex: 1; overflow-y: auto; padding: 1.25rem 1.5rem; }

  #btn-concluir.done {
    background: #b9ff66; color: #191a23; border-color: #191a23;
  }
</style>

<!-- marked.js para render de Markdown -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/4.3.0/marked.min.js"></script>

<!-- Topbar -->
<div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
  <a id="back" href="/cursos" class="inline-flex items-center gap-1.5 text-sm text-dark/45 hover:text-dark transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    <span id="back-label">Voltar</span>
  </a>
  <div class="flex items-center gap-2">
    <button id="btn-concluir" class="btn-secondary text-sm py-2 px-4">Marcar concluída</button>
    <button id="btn-edit" class="btn-primary text-sm py-2 px-4">Editar</button>
  </div>
</div>

<!-- Meta -->
<div class="mb-6">
  <p id="meta-breadcrumb" class="text-xs font-semibold text-dark/35 uppercase tracking-widest mb-1.5"></p>
  <h1 id="aula-titulo" class="text-2xl font-semibold leading-snug">…</h1>
  <p id="aula-dur" class="text-sm text-dark/35 mt-1 hidden"></p>
</div>

<!-- Read mode -->
<div id="read-view">
  <div id="read-content" class="prose"></div>
</div>

<!-- Edit mode (hidden) -->
<div id="edit-view">
  <div class="pane">
    <div class="pane-label">Markdown</div>
    <textarea id="md-ta" placeholder="# Título&#10;&#10;Escreva o conteúdo em Markdown…"></textarea>
  </div>
  <div class="pane" id="preview-pane-wrap">
    <div class="pane-label">Preview</div>
    <div id="preview-pane" class="prose"></div>
  </div>
</div>

<!-- Edit actions (hidden) -->
<div id="edit-actions" class="hidden flex gap-2 mt-4">
  <button id="btn-cancel" class="btn-secondary">Cancelar</button>
  <button id="btn-save" class="btn-primary">Salvar</button>
</div>

<script>
  const token = localStorage.getItem('gab_token');
  const aid = new URLSearchParams(location.search).get('id');
  if (!aid) location.href = '/cursos';

  let aula: any = null;

  async function load() {
    const res = await fetch(`/api/cursos/aulas/${aid}`, { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) { location.href = '/cursos'; return; }
    aula = await res.json();
    renderMeta();
    renderContent();
  }

  function renderMeta() {
    document.title = `${aula.titulo} · Gabarita`;
    (document.getElementById('aula-titulo') as HTMLElement).textContent = aula.titulo;
    (document.getElementById('meta-breadcrumb') as HTMLElement).textContent =
      `${aula.curso_titulo}  ·  ${aula.modulo_titulo}`;

    const back = document.getElementById('back') as HTMLAnchorElement;
    back.href = `/curso?id=${aula.curso_id}`;
    (document.getElementById('back-label') as HTMLElement).textContent = aula.curso_titulo;

    const dur = document.getElementById('aula-dur') as HTMLElement;
    if (aula.duracao_min > 0) {
      dur.textContent = `⏱ ${aula.duracao_min} min de leitura`;
      dur.classList.remove('hidden');
    }

    const btn = document.getElementById('btn-concluir')!;
    if (aula.concluida) {
      btn.textContent = '✓ Concluída';
      btn.classList.add('done');
    } else {
      btn.textContent = 'Marcar concluída';
      btn.classList.remove('done');
    }
  }

  function renderContent() {
    const md = aula.conteudo_md || '';
    const html = md
      ? (window as any).marked.parse(md)
      : '<p style="color:rgba(25,26,35,0.3);font-style:italic">Nenhum conteúdo ainda. Clique em <strong>Editar</strong> para começar.</p>';
    (document.getElementById('read-content') as HTMLElement).innerHTML = html;
  }

  // ── Editar ──
  document.getElementById('btn-edit')!.addEventListener('click', enterEdit);

  function enterEdit() {
    document.getElementById('read-view')!.classList.add('hidden');
    document.getElementById('edit-view')!.classList.add('show');
    document.getElementById('edit-actions')!.classList.remove('hidden');
    document.getElementById('btn-edit')!.classList.add('hidden');
    document.getElementById('btn-concluir')!.classList.add('hidden');

    const ta = document.getElementById('md-ta') as HTMLTextAreaElement;
    ta.value = aula.conteudo_md || '';
    updatePreview(ta.value);
    ta.focus();
  }

  function exitEdit() {
    document.getElementById('read-view')!.classList.remove('hidden');
    document.getElementById('edit-view')!.classList.remove('show');
    document.getElementById('edit-actions')!.classList.add('hidden');
    document.getElementById('btn-edit')!.classList.remove('hidden');
    document.getElementById('btn-concluir')!.classList.remove('hidden');
  }

  document.getElementById('md-ta')!.addEventListener('input', e => {
    updatePreview((e.target as HTMLTextAreaElement).value);
  });

  function updatePreview(md: string) {
    (document.getElementById('preview-pane') as HTMLElement).innerHTML =
      md ? (window as any).marked.parse(md) : '';
  }

  document.getElementById('btn-cancel')!.addEventListener('click', exitEdit);

  document.getElementById('btn-save')!.addEventListener('click', async () => {
    const conteudo = (document.getElementById('md-ta') as HTMLTextAreaElement).value;
    const btn = document.getElementById('btn-save') as HTMLButtonElement;
    btn.textContent = 'Salvando…'; btn.disabled = true;

    const res = await fetch(`/api/cursos/aulas/${aid}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo: aula.titulo, conteudo_md: conteudo, duracao_min: aula.duracao_min }),
    });

    btn.textContent = 'Salvar'; btn.disabled = false;

    if (res.ok) {
      aula.conteudo_md = conteudo;
      renderContent();
      exitEdit();
    }
  });

  // ── Concluir ──
  document.getElementById('btn-concluir')!.addEventListener('click', async () => {
    const nova = !aula.concluida;
    await fetch(`/api/cursos/aulas/${aid}/concluir`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ concluida: nova }),
    });
    aula.concluida = nova;
    renderMeta();
  });

  load();
</script>
</MainLayout>
