---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Aula">

<link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.bubble.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
<!-- marked.js: só usado como fallback para aulas antigas salvas em Markdown puro -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/4.3.0/marked.min.js"></script>

<style is:global>
  /* A tela toda é a área de escrita — sem fundo, sem cabeçalho fixo.
     Toolbar só aparece ao selecionar texto (tema bubble do Quill). */
  #toolbar.locked { display: none !important; }

  /* Largura do texto — centralizado (padrão) ou largura total, como no Notion.
     Aplicado no wrapper (título + editor) para os dois ficarem sempre alinhados. */
  #content-wrap {
    padding-left: max(1.5rem, calc(50% - 430px));
    padding-right: max(1.5rem, calc(50% - 430px));
    transition: padding 0.2s;
  }
  #content-wrap.full-width {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  #editor .ql-editor {
    min-height: calc(100vh - 280px);
    font-size: 1rem;
    padding: 1rem 0 4rem;
  }
  #editor.locked .ql-editor { cursor: default; }

  /* Espaçamento entre linhas, como no Word */
  #editor .ql-editor[data-spacing="compact"] { line-height: 1.4; }
  #editor .ql-editor[data-spacing="normal"]  { line-height: 1.8; }
  #editor .ql-editor[data-spacing="relaxed"] { line-height: 2.2; }
  #editor .ql-editor[data-spacing="loose"]   { line-height: 2.6; }
  #editor .ql-editor.ql-blank::before {
    content: none;
  }

  /* Colunas */
  #editor .ql-editor.cols-2 {
    column-count: 2;
    column-gap: 3rem;
  }
  #editor .ql-editor.cols-2 h1,
  #editor .ql-editor.cols-2 h2,
  #editor .ql-editor.cols-2 h3,
  #editor .ql-editor.cols-2 blockquote,
  #editor .ql-editor.cols-2 li {
    break-inside: avoid;
  }

  #btn-concluir.done {
    background: #b9ff66; color: #191a23; border-color: #191a23;
  }
  .layout-btn { padding: 0.5rem; border-radius: 10px; color: rgba(25,26,35,0.4); transition: all 0.15s; }
  .layout-btn:hover { color: #191a23; background: rgba(25,26,35,0.05); }
  .layout-btn.active { color: #191a23; background: rgba(185,255,102,0.35); }
  #save-status { transition: opacity 0.2s; }
</style>

<!-- Topbar -->
<div class="flex items-center justify-between mb-5 gap-3 flex-wrap">
  <a id="back" href="/cursos" class="inline-flex items-center gap-1.5 text-sm text-dark/45 hover:text-dark transition-colors">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    <span id="back-label">Voltar</span>
  </a>
  <div class="flex items-center gap-3">
    <div class="flex items-center gap-0.5">
      <button id="btn-width" class="layout-btn" title="Largura do texto: centralizado / total">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/>
        </svg>
      </button>
      <button id="btn-columns" class="layout-btn" title="Dividir em colunas">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z"/>
        </svg>
      </button>
      <button id="btn-spacing" class="layout-btn" title="Espaçamento entre linhas">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h7.5M3 9.75h7.5M3 15h7.5M3 20.25h7.5"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 3.75l-3 3m3-3l3 3m-3-3v16.5m0 0l-3-3m3 3l3-3"/>
        </svg>
      </button>
    </div>
    <div class="w-px h-5 bg-dark/10"></div>
    <span id="save-status" class="text-xs text-dark/35"></span>
    <button id="btn-concluir" class="btn-secondary text-sm py-2 px-4">Marcar concluída</button>
    <button id="btn-lock" class="btn-primary text-sm py-2 px-4 flex items-center gap-1.5">
      <svg id="lock-icon-view" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <svg id="lock-icon-edit" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
      </svg>
      <span id="lock-label">Visualizar</span>
    </button>
  </div>
</div>

<!-- Título e editor compartilham a mesma largura/alinhamento -->
<div id="content-wrap">

<!-- Meta -->
<div class="mb-6">
  <p id="meta-breadcrumb" class="text-xs font-semibold text-dark/35 uppercase tracking-widest mb-1.5"></p>
  <h1 id="aula-titulo" class="text-2xl font-semibold leading-snug">…</h1>
  <p id="aula-dur" class="text-sm text-dark/35 mt-1 hidden"></p>
</div>

<!-- Editor (rich text, sempre aberto) -->
<div id="editor-card">
  <div id="toolbar">
    <span class="ql-formats">
      <select class="ql-header" defaultValue="0">
        <option value="1"></option>
        <option value="2"></option>
        <option value="3"></option>
        <option value="0" selected></option>
      </select>
      <select class="ql-size">
        <option value="small"></option>
        <option selected></option>
        <option value="large"></option>
        <option value="huge"></option>
      </select>
    </span>
    <span class="ql-formats">
      <button class="ql-bold"></button>
      <button class="ql-italic"></button>
      <button class="ql-underline"></button>
      <button class="ql-strike"></button>
    </span>
    <span class="ql-formats">
      <select class="ql-background" title="Marca-texto">
        <option value="#fff3a3" selected></option>
        <option value="#b9ff66"></option>
        <option value="#a3d4ff"></option>
        <option value="#ffc9a3"></option>
        <option value="#ffb3d1"></option>
        <option value=""></option>
      </select>
      <select class="ql-color" title="Cor do texto">
        <option value="#191a23" selected></option>
        <option value="#dc2626"></option>
        <option value="#2563eb"></option>
        <option value="#16a34a"></option>
        <option value="#d97706"></option>
      </select>
    </span>
    <span class="ql-formats">
      <select class="ql-align">
        <option selected></option>
        <option value="center"></option>
        <option value="right"></option>
        <option value="justify"></option>
      </select>
    </span>
    <span class="ql-formats">
      <button class="ql-list" value="ordered"></button>
      <button class="ql-list" value="bullet"></button>
      <button class="ql-blockquote"></button>
      <button class="ql-code-block"></button>
    </span>
    <span class="ql-formats">
      <button class="ql-link"></button>
      <button class="ql-clean"></button>
    </span>
  </div>
  <div id="editor"></div>
</div>

</div>

<script>
  const token = localStorage.getItem('gab_token');
  const aid = new URLSearchParams(location.search).get('id');
  if (!aid) location.href = '/cursos';

  let aula: any = null;
  let quill: any = null;
  let saveTimer: ReturnType<typeof setTimeout> | null = null;
  let loading = true;

  function initQuill() {
    quill = new (window as any).Quill('#editor', {
      theme: 'bubble',
      modules: { toolbar: '#toolbar' },
    });
    quill.disable();
    quill.on('text-change', (_delta: any, _old: any, source: string) => {
      if (loading || source !== 'user') return;
      scheduleSave();
    });
    applyWidth();
    applyColumns();
    applySpacing();
  }

  // ── Largura do texto: centralizado (padrão) ou total, como no Notion ──
  const btnWidth = document.getElementById('btn-width') as HTMLButtonElement;
  let fullWidth = localStorage.getItem('gab_aula_full_width') === '1';
  function applyWidth() {
    document.getElementById('content-wrap')?.classList.toggle('full-width', fullWidth);
    btnWidth.classList.toggle('active', fullWidth);
  }
  btnWidth.addEventListener('click', () => {
    fullWidth = !fullWidth;
    localStorage.setItem('gab_aula_full_width', fullWidth ? '1' : '0');
    applyWidth();
  });

  // ── Dividir em colunas ──
  const btnColumns = document.getElementById('btn-columns') as HTMLButtonElement;
  let columns = localStorage.getItem('gab_aula_columns') === '1';
  function applyColumns() {
    document.querySelector('.ql-editor')?.classList.toggle('cols-2', columns);
    btnColumns.classList.toggle('active', columns);
  }
  btnColumns.addEventListener('click', () => {
    columns = !columns;
    localStorage.setItem('gab_aula_columns', columns ? '1' : '0');
    applyColumns();
  });

  // ── Espaçamento entre linhas (como no Word) ──
  const btnSpacing = document.getElementById('btn-spacing') as HTMLButtonElement;
  const spacingSteps = ['compact', 'normal', 'relaxed', 'loose'];
  const spacingLabels: Record<string, string> = {
    compact: 'Compacto', normal: 'Normal', relaxed: 'Espaçado', loose: 'Muito espaçado',
  };
  let spacingIdx = spacingSteps.indexOf(localStorage.getItem('gab_aula_spacing') || 'normal');
  if (spacingIdx < 0) spacingIdx = 1;
  function applySpacing() {
    const val = spacingSteps[spacingIdx];
    document.querySelector('.ql-editor')?.setAttribute('data-spacing', val);
    btnSpacing.classList.toggle('active', val !== 'normal');
    btnSpacing.title = `Espaçamento entre linhas: ${spacingLabels[val]} (clique para alternar)`;
  }
  btnSpacing.addEventListener('click', () => {
    spacingIdx = (spacingIdx + 1) % spacingSteps.length;
    localStorage.setItem('gab_aula_spacing', spacingSteps[spacingIdx]);
    applySpacing();
  });

  async function load() {
    const res = await fetch(`/api/cursos/aulas/${aid}`, { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) { location.href = '/cursos'; return; }
    aula = await res.json();
    renderMeta();

    const raw = aula.conteudo_md || '';
    const html = raw && !raw.includes('<')
      ? (window as any).marked.parse(raw)   // aula antiga salva em Markdown puro
      : raw;
    quill.clipboard.dangerouslyPasteHTML(html || '');
    loading = false;
    setLocked(false);
  }

  function renderMeta() {
    document.title = `${aula.titulo} · Gabarita`;
    (window as any).setBreadcrumb?.(['Gabarita', aula.curso_titulo, aula.modulo_titulo, aula.titulo]);
    (document.getElementById('aula-titulo') as HTMLElement).textContent = aula.titulo;
    (document.getElementById('meta-breadcrumb') as HTMLElement).textContent =
      `${aula.curso_titulo}  ·  ${aula.modulo_titulo}`;

    const back = document.getElementById('back') as HTMLAnchorElement;
    back.href = `/curso?id=${aula.curso_id}`;
    (document.getElementById('back-label') as HTMLElement).textContent = aula.curso_titulo;

    const dur = document.getElementById('aula-dur') as HTMLElement;
    if (aula.duracao_min > 0) {
      dur.textContent = `⏱ ${aula.duracao_min} min de leitura`;
      dur.classList.remove('hidden');
    }

    const btn = document.getElementById('btn-concluir')!;
    if (aula.concluida) {
      btn.textContent = '✓ Concluída';
      btn.classList.add('done');
    } else {
      btn.textContent = 'Marcar concluída';
      btn.classList.remove('done');
    }
  }

  // ── Visualizar / Editar (trava a edição) ──
  let locked = false;
  function setLocked(v: boolean) {
    locked = v;
    if (locked) quill.disable(); else quill.enable();
    document.getElementById('toolbar')!.classList.toggle('locked', locked);
    document.getElementById('editor')!.classList.toggle('locked', locked);
    document.getElementById('lock-icon-view')!.classList.toggle('hidden', locked);
    document.getElementById('lock-icon-edit')!.classList.toggle('hidden', !locked);
    document.getElementById('lock-label')!.textContent = locked ? 'Editar' : 'Visualizar';
  }
  document.getElementById('btn-lock')!.addEventListener('click', () => setLocked(!locked));

  // ── Autosave ──
  function scheduleSave() {
    const statusEl = document.getElementById('save-status')!;
    statusEl.textContent = 'Editando…';
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(doSave, 1200);
  }

  async function doSave() {
    const statusEl = document.getElementById('save-status')!;
    statusEl.textContent = 'Salvando…';
    const conteudo = quill.root.innerHTML;
    const res = await fetch(`/api/cursos/aulas/${aid}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo: aula.titulo, conteudo_md: conteudo, duracao_min: aula.duracao_min }),
    });
    if (res.ok) {
      aula.conteudo_md = conteudo;
      statusEl.textContent = 'Salvo ✓';
      setTimeout(() => { if (statusEl.textContent === 'Salvo ✓') statusEl.textContent = ''; }, 2000);
    } else {
      statusEl.textContent = 'Erro ao salvar';
    }
  }

  // ── Concluir ──
  document.getElementById('btn-concluir')!.addEventListener('click', async () => {
    const nova = !aula.concluida;
    await fetch(`/api/cursos/aulas/${aid}/concluir`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ concluida: nova }),
    });
    aula.concluida = nova;
    renderMeta();
  });

  initQuill();
  load();
</script>
</MainLayout>
