---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Agenda">
  <div class="page-wrap">
    <div class="page-header">
      <div>
        <h1 class="page-title">Agenda</h1>
        <p class="page-sub">Datas importantes dos seus cursos</p>
      </div>
      <button id="btn-add" class="btn-primary">+ Adicionar data</button>
    </div>

    <!-- Modal nova data manual -->
    <div id="modal-add" class="modal-backdrop hidden">
      <div class="modal-box">
        <h2 class="modal-title">Nova data</h2>
        <div class="form-group">
          <label>Nome / Descrição</label>
          <input id="inp-nome" type="text" placeholder="Ex: Prova 1 de Cálculo" class="inp">
        </div>
        <div class="form-group">
          <label>Data</label>
          <input id="inp-data" type="date" class="inp">
        </div>
        <div class="form-group">
          <label>Status</label>
          <select id="inp-status" class="inp">
            <option value="confirmada">Confirmada</option>
            <option value="estimada">Estimada</option>
          </select>
        </div>
        <div class="form-group">
          <label>Curso (opcional)</label>
          <select id="inp-curso" class="inp">
            <option value="">— nenhum —</option>
          </select>
        </div>
        <p id="modal-err" class="err-msg hidden"></p>
        <div class="modal-actions">
          <button id="btn-cancel" class="btn-sec">Cancelar</button>
          <button id="btn-save" class="btn-primary">Salvar</button>
        </div>
      </div>
    </div>

    <!-- Lista de eventos -->
    <div id="empty-state" class="empty-state hidden">
      <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="empty-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <p>Nenhuma data cadastrada ainda.</p>
      <p class="empty-hint">Importe um programa de disciplina em PDF ou adicione manualmente.</p>
    </div>

    <div id="eventos-list"></div>
  </div>
</MainLayout>

<style>
  .page-wrap { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }
  .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .page-title { font-size: 1.5rem; font-weight: 700; color: var(--text); }
  .page-sub { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem; }

  .btn-primary {
    background: #b9ff66; color: #191a23; font-weight: 600;
    border: none; border-radius: 8px; padding: 0.55rem 1.1rem;
    font-size: 0.875rem; cursor: pointer; white-space: nowrap;
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-sec {
    background: transparent; color: var(--text-muted);
    border: 1px solid var(--border); border-radius: 8px;
    padding: 0.55rem 1.1rem; font-size: 0.875rem; cursor: pointer;
  }
  .btn-sec:hover { background: var(--surface); }

  .inp {
    width: 100%; border: 1px solid var(--border); border-radius: 8px;
    padding: 0.6rem 0.75rem; font-size: 0.9rem;
    background: var(--surface); color: var(--text);
    box-sizing: border-box;
  }
  .inp:focus { outline: 2px solid #b9ff66; border-color: transparent; }

  .modal-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 100; padding: 1rem;
  }
  .modal-backdrop.hidden { display: none; }
  .modal-box {
    background: var(--card); border-radius: 16px; padding: 1.5rem;
    width: 100%; max-width: 440px; display: flex; flex-direction: column; gap: 1rem;
  }
  .modal-title { font-size: 1.1rem; font-weight: 700; color: var(--text); }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-group label { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); }
  .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; padding-top: 0.5rem; }
  .err-msg { color: #f87171; font-size: 0.82rem; }
  .err-msg.hidden { display: none; }

  /* Month headers */
  .month-group { margin-bottom: 1.5rem; }
  .month-label {
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-muted);
    padding-bottom: 0.5rem; margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .evento-row {
    display: flex; align-items: center; gap: 0.875rem;
    padding: 0.75rem 0.5rem; border-radius: 10px;
    transition: background 0.15s;
  }
  .evento-row:hover { background: var(--surface); }
  .evento-date-box {
    display: flex; flex-direction: column; align-items: center;
    min-width: 44px; background: var(--surface);
    border-radius: 8px; padding: 0.4rem 0.3rem;
    border: 1px solid var(--border);
  }
  .evento-day { font-size: 1.1rem; font-weight: 800; line-height: 1; color: var(--text); }
  .evento-mon { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); }
  .evento-info { flex: 1; min-width: 0; }
  .evento-nome { font-size: 0.9rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .evento-curso { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.1rem; }
  .badge {
    font-size: 0.65rem; font-weight: 700; border-radius: 20px;
    padding: 0.2rem 0.6rem; white-space: nowrap;
  }
  .badge-green { background: rgba(185,255,102,0.2); color: #5a9a00; }
  .badge-yellow { background: rgba(250,204,21,0.2); color: #a16207; }
  .past .evento-day, .past .evento-nome { opacity: 0.45; }
  .past .badge-green { background: rgba(185,255,102,0.1); }

  .btn-del {
    background: none; border: none; cursor: pointer; padding: 0.3rem;
    color: var(--text-muted); border-radius: 6px; display: flex;
    transition: color 0.15s, background 0.15s;
  }
  .btn-del:hover { color: #f87171; background: rgba(248,113,113,0.1); }

  .empty-state {
    text-align: center; padding: 3rem 1rem; color: var(--text-muted);
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  }
  .empty-state.hidden { display: none; }
  .empty-icon { opacity: 0.3; margin-bottom: 0.5rem; }
  .empty-hint { font-size: 0.8rem; opacity: 0.7; }
</style>

<script>
  const API = '';
  const token = () => localStorage.getItem('token') || '';

  const listEl    = document.getElementById('eventos-list')!;
  const emptyEl   = document.getElementById('empty-state')!;
  const modalEl   = document.getElementById('modal-add')!;
  const inpNome   = document.getElementById('inp-nome') as HTMLInputElement;
  const inpData   = document.getElementById('inp-data') as HTMLInputElement;
  const inpStatus = document.getElementById('inp-status') as HTMLSelectElement;
  const inpCurso  = document.getElementById('inp-curso') as HTMLSelectElement;
  const modalErr  = document.getElementById('modal-err')!;

  const MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const MESES_LONG = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

  let eventos: any[] = [];

  async function loadAgenda() {
    try {
      const r = await fetch('/api/agenda', { headers: { Authorization: `Bearer ${token()}` } });
      if (!r.ok) return;
      eventos = await r.json();
      renderEventos();
    } catch {}
  }

  async function loadCursos() {
    try {
      const r = await fetch('/api/cursos', { headers: { Authorization: `Bearer ${token()}` } });
      if (!r.ok) return;
      const cursos = await r.json();
      cursos.forEach((c: any) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.titulo;
        inpCurso.appendChild(opt);
      });
    } catch {}
  }

  function renderEventos() {
    if (!eventos.length) {
      emptyEl.classList.remove('hidden');
      listEl.innerHTML = '';
      return;
    }
    emptyEl.classList.add('hidden');

    const today = new Date().toISOString().slice(0, 10);

    // group by YYYY-MM
    const groups: Record<string, any[]> = {};
    for (const e of eventos) {
      const key = e.data.slice(0, 7);
      if (!groups[key]) groups[key] = [];
      groups[key].push(e);
    }

    let html = '';
    for (const [ym, evs] of Object.entries(groups)) {
      const [y, m] = ym.split('-');
      html += `<div class="month-group">
        <div class="month-label">${MESES_LONG[parseInt(m)-1]} ${y}</div>`;
      for (const e of evs) {
        const parts = e.data.split('-');
        const day = parts[2];
        const mon = MESES[parseInt(parts[1])-1];
        const past = e.data < today ? 'past' : '';
        const badge = e.status === 'estimada'
          ? `<span class="badge badge-yellow">estimada</span>`
          : `<span class="badge badge-green">confirmada</span>`;
        const cursoInfo = e.curso_titulo
          ? `<div class="evento-curso">${e.curso_titulo}</div>`
          : '';
        html += `<div class="evento-row ${past}">
          <div class="evento-date-box">
            <span class="evento-day">${day}</span>
            <span class="evento-mon">${mon}</span>
          </div>
          <div class="evento-info">
            <div class="evento-nome">${e.nome}</div>
            ${cursoInfo}
          </div>
          ${badge}
          <button class="btn-del" data-id="${e.id}" title="Remover">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>`;
      }
      html += '</div>';
    }
    listEl.innerHTML = html;

    listEl.querySelectorAll('.btn-del').forEach(btn => {
      btn.addEventListener('click', async (ev) => {
        const id = (btn as HTMLElement).dataset.id;
        await fetch(`/api/agenda/${id}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token()}` },
        });
        eventos = eventos.filter(e => String(e.id) !== id);
        renderEventos();
      });
    });
  }

  document.getElementById('btn-add')!.addEventListener('click', () => {
    inpNome.value = '';
    inpData.value = '';
    inpStatus.value = 'confirmada';
    inpCurso.value = '';
    modalErr.classList.add('hidden');
    modalEl.classList.remove('hidden');
    inpNome.focus();
  });

  document.getElementById('btn-cancel')!.addEventListener('click', () => {
    modalEl.classList.add('hidden');
  });

  modalEl.addEventListener('click', (e) => {
    if (e.target === modalEl) modalEl.classList.add('hidden');
  });

  document.getElementById('btn-save')!.addEventListener('click', async () => {
    const nome   = inpNome.value.trim();
    const data   = inpData.value;
    const status = inpStatus.value;
    const curso_id = inpCurso.value || null;

    if (!nome) { showErr('Informe um nome.'); return; }
    if (!data) { showErr('Selecione uma data.'); return; }

    const r = await fetch('/api/agenda', {
      method: 'POST',
      headers: { Authorization: `Bearer ${token()}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ nome, data, status, curso_id }),
    });
    const json = await r.json();
    if (!r.ok) { showErr(json.error || 'Erro ao salvar.'); return; }

    eventos = [...eventos, json].sort((a, b) => a.data.localeCompare(b.data));
    renderEventos();
    modalEl.classList.add('hidden');
  });

  function showErr(msg: string) {
    modalErr.textContent = msg;
    modalErr.classList.remove('hidden');
  }

  loadCursos();
  loadAgenda();
</script>
