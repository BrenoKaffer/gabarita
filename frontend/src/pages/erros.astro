---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Erros">

<style>
  .disc-chip {
    padding: 5px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 500;
    border: 1.5px solid rgba(25,26,35,0.2); background: white; color: rgba(25,26,35,0.6);
    cursor: pointer; transition: all 0.15s; white-space: nowrap;
  }
  .disc-chip:hover { border-color: #191a23; color: #191a23; }
  .disc-chip.active { background: #191a23; border-color: #191a23; color: white; }

  .tab-btn {
    padding: 8px 16px; font-size: 0.8125rem; font-weight: 600;
    border-radius: 10px; border: 1.5px solid transparent; background: none;
    color: rgba(25,26,35,0.45); cursor: pointer; transition: all 0.15s;
  }
  .tab-btn:hover { color: #191a23; }
  .tab-btn.active { background: #191a23; color: white; }

  .alt-label { font-size: 0.7rem; font-weight: 700; margin-left: auto; padding-left: 8px; white-space: nowrap; }
</style>

<!-- Header -->
<div class="flex items-center justify-between mb-5 flex-wrap gap-3">
  <div>
    <h1 class="text-xl font-semibold">Revisão de <span class="greenhead">Erros</span></h1>
    <p id="err-label" class="text-xs text-dark/40 mt-0.5">Carregando…</p>
  </div>
  <div id="err-badge"
    class="hidden items-center gap-1.5 bg-red-50 border border-red-200 text-red-600 rounded-full px-3 py-1 text-xs font-semibold">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </svg>
    <span id="err-count">0</span> erros
  </div>
</div>

<!-- Tabs: Erros vs Acertei no chute -->
<div class="flex gap-2 mb-4">
  <button class="tab-btn active" id="tab-erros">Erros</button>
  <button class="tab-btn" id="tab-chutei">Acertei no chute</button>
</div>

<!-- Discipline chips -->
<div id="disc-chips" class="flex flex-wrap gap-2 mb-5"></div>

<!-- Progress -->
<div class="flex items-center gap-3 mb-4 text-xs text-dark/40">
  <span id="q-counter">0 / 0</span>
  <div class="flex-1 h-1 rounded-full bg-dark/10 overflow-hidden">
    <div id="q-progress" class="h-full bg-red-400 rounded-full transition-all duration-300" style="width:0%"></div>
  </div>
</div>

<!-- Question area -->
<div id="question-area" class="mb-4"></div>

<!-- Nav -->
<div class="flex gap-3">
  <button id="btn-prev" class="btn-secondary text-sm px-4 py-2.5" disabled>← Anterior</button>
  <button id="btn-next" class="btn-primary text-sm px-4 py-2.5 ml-auto">Próxima →</button>
</div>
</MainLayout>

<script>
const token = localStorage.getItem('gab_token');

let errosList: any[] = [];
let chuteiList: any[] = [];
let activeTab: 'erros' | 'chutei' = 'erros';
let filtered: any[] = [];
let current = 0;
let activeDisc = '';

async function init() {
  const res = await fetch('/api/progress/errors', { headers: { Authorization: `Bearer ${token}` } });
  const data = res.ok ? await res.json() : { erros: [], chutei_acertos: [] };
  errosList = data.erros;
  chuteiList = data.chutei_acertos;

  const badge = document.getElementById('err-badge')!;
  const countEl = document.getElementById('err-count')!;
  if (errosList.length > 0) {
    badge.classList.remove('hidden');
    badge.classList.add('flex');
    countEl.textContent = String(errosList.length);
  }

  document.getElementById('tab-chutei')!.textContent = `Acertei no chute (${chuteiList.length})`;

  buildDiscChips();
  applyFilters();
}

function activeList() {
  return activeTab === 'erros' ? errosList : chuteiList;
}

function buildDiscChips() {
  const list = activeList();
  const discs = [...new Set<string>(list.map(e => e.disc).filter(Boolean))].sort();

  const container = document.getElementById('disc-chips')!;
  container.innerHTML = '';

  const all = document.createElement('button');
  all.className = 'disc-chip active';
  all.textContent = `Todas (${list.length})`;
  all.dataset.disc = '';
  all.addEventListener('click', () => setDisc('', all));
  container.appendChild(all);

  for (const d of discs) {
    const count = list.filter(e => e.disc === d).length;
    const btn   = document.createElement('button');
    btn.className   = 'disc-chip';
    btn.textContent = `${d} (${count})`;
    btn.dataset.disc = d;
    btn.addEventListener('click', () => setDisc(d, btn));
    container.appendChild(btn);
  }
}

function setDisc(disc: string, btn: HTMLElement) {
  activeDisc = disc;
  document.querySelectorAll('#disc-chips .disc-chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  current = 0;
  applyFilters();
}

function applyFilters() {
  filtered = activeList().filter(e => !activeDisc || e.disc === activeDisc);

  const label = activeTab === 'erros' ? 'erro' : 'lacuna';
  document.getElementById('err-label')!.textContent =
    `${filtered.length} ${label}${filtered.length !== 1 ? 's' : ''} para revisar`;
  renderQuestion();
}

function renderQuestion() {
  const area    = document.getElementById('question-area')!;
  const counter = document.getElementById('q-counter')!;
  const bar     = document.getElementById('q-progress')!;

  if (!filtered.length) {
    counter.textContent = '0 / 0';
    bar.style.width     = '0%';
    (document.getElementById('btn-prev') as HTMLButtonElement).disabled = true;
    (document.getElementById('btn-next') as HTMLButtonElement).disabled = true;
    const msg = activeTab === 'erros'
      ? { title: 'Nenhum erro encontrado!', sub: 'Continue assim — seu aproveitamento está ótimo.' }
      : { title: 'Nenhuma lacuna encontrada!', sub: 'Você não tem acertos no chute pendentes de revisão.' };
    area.innerHTML = `
      <div class="q-card">
        <div class="empty-state">
          <div class="empty-icon">
            <svg class="w-7 h-7 text-green" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <p class="font-semibold text-dark mb-1">${msg.title}</p>
          <p class="text-sm text-dark/50">${msg.sub}</p>
        </div>
      </div>`;
    return;
  }

  (document.getElementById('btn-prev') as HTMLButtonElement).disabled = current === 0;
  (document.getElementById('btn-next') as HTMLButtonElement).disabled = current >= filtered.length - 1;

  counter.textContent = `${current + 1} / ${filtered.length}`;
  bar.style.width     = `${((current + 1) / filtered.length) * 100}%`;

  const e = filtered[current];

  const metaParts = [
    e.ano   ? `Ano: <strong>${e.ano}</strong>`     : '',
    e.banca ? `Banca: <strong>${e.banca}</strong>` : '',
  ].filter(Boolean).join('<span class="mx-2 opacity-30">·</span>');

  const altsHtml = e.a.map((alt: any) => {
    const isChosen  = alt.l === e.chosen;
    const isCorrect = e.correct_answer && alt.l === e.correct_answer;
    let cls = '';
    let labelHtml = '';
    if (isCorrect) {
      cls = 'alt-correct';
      labelHtml = `<span class="alt-label text-green-700">✓ Correta</span>`;
    } else if (isChosen) {
      cls = 'alt-wrong';
      labelHtml = `<span class="alt-label text-red-500">✗ Sua resposta</span>`;
    } else {
      cls = 'alt-neutral';
    }
    return `
      <div class="alt-opt ${cls}">
        <span class="alt-letter">${alt.l}</span>
        <span class="alt-text">${alt.t}</span>
        ${labelHtml}
      </div>`;
  }).join('');

  const resultHtml = activeTab === 'chutei'
    ? `<div class="mt-3 flex items-center gap-2 text-sm font-semibold bg-amber-100 text-amber-700 rounded-lg px-4 py-2.5">
         <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
           <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0110.5 3h3A2.25 2.25 0 0115.75 5.25V9m-7.5 0a2.25 2.25 0 00-2.25 2.25v7.5A2.25 2.25 0 008.25 21h7.5a2.25 2.25 0 002.25-2.25v-7.5A2.25 2.25 0 0015.75 9m-7.5 0h7.5"/></svg>
         Você acertou, mas chutou — vale revisar o porquê.
       </div>`
    : e.correct_answer
    ? `<div class="mt-3 flex items-center gap-2 text-sm font-semibold bg-green text-dark rounded-lg px-4 py-2.5">
         <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
           <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
         Resposta correta: ${e.correct_answer}
       </div>`
    : `<div class="mt-3 text-sm text-dark/50 bg-dark/5 rounded-lg px-4 py-2.5">
         Gabarito ainda não disponível para esta questão.</div>`;

  area.innerHTML = `
    <div class="q-card">
      <div class="q-header">
        <span class="q-num">${current + 1}</span>
        <span class="q-id">${e.question_id}</span>
        <span class="q-breadcrumb"><strong>${e.disc || '—'}</strong>${e.assunto ? ` › ${e.assunto}` : ''}</span>
        <span class="ml-auto text-xs ${activeTab === 'chutei' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-600'} px-2.5 py-0.5 rounded-full font-medium">
          Respondeu: ${e.chosen || '—'}
        </span>
      </div>
      ${metaParts ? `<div class="q-meta"><span>${metaParts}</span></div>` : ''}
      <div class="q-body">
        <p class="q-enunciado">${e.e}</p>
      </div>
      <div class="px-4 pb-3 flex flex-col gap-2">${altsHtml}</div>
      <div class="px-4 pb-4">${resultHtml}</div>
    </div>`;
}

document.getElementById('tab-erros')!.addEventListener('click', () => {
  activeTab = 'erros';
  document.getElementById('tab-erros')!.classList.add('active');
  document.getElementById('tab-chutei')!.classList.remove('active');
  activeDisc = ''; current = 0;
  buildDiscChips();
  applyFilters();
});
document.getElementById('tab-chutei')!.addEventListener('click', () => {
  activeTab = 'chutei';
  document.getElementById('tab-chutei')!.classList.add('active');
  document.getElementById('tab-erros')!.classList.remove('active');
  activeDisc = ''; current = 0;
  buildDiscChips();
  applyFilters();
});

document.getElementById('btn-next')?.addEventListener('click', () => {
  if (current < filtered.length - 1) { current++; renderQuestion(); }
});
document.getElementById('btn-prev')?.addEventListener('click', () => {
  if (current > 0) { current--; renderQuestion(); }
});

init();
</script>
