---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Curso">

<style is:global>
  .module-block {
    background: white;
    border: 1.5px solid rgba(25,26,35,0.1);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 0.625rem;
  }
  .mod-header {
    display: flex; align-items: center; gap: 0.625rem;
    padding: 0.75rem 1rem;
    cursor: pointer; user-select: none;
    transition: background 0.1s;
  }
  .mod-header:hover { background: rgba(25,26,35,0.02); }
  .chevron {
    width: 16px; height: 16px; color: rgba(25,26,35,0.3);
    flex-shrink: 0; transition: transform 0.2s;
  }
  .chevron.closed { transform: rotate(-90deg); }
  .aula-row {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.6rem 1rem 0.6rem 1.375rem;
    border-top: 1px solid rgba(25,26,35,0.06);
    text-decoration: none;
    transition: background 0.1s;
    color: #191a23;
  }
  .aula-row:hover { background: rgba(185,255,102,0.1); }
  .check-ring {
    width: 20px; height: 20px; border-radius: 50%;
    border: 2px solid rgba(25,26,35,0.18);
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: all 0.15s;
  }
  .check-ring.done { background: #b9ff66; border-color: #b9ff66; }
  .add-aula-btn {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.55rem 1rem 0.55rem 1.375rem;
    border-top: 1px solid rgba(25,26,35,0.06);
    font-size: 0.8rem; color: rgba(25,26,35,0.35);
    cursor: pointer; transition: all 0.1s; background: none; border-left: none; border-right: none; border-bottom: none; width: 100%; text-align: left;
  }
  .add-aula-btn:hover { background: rgba(25,26,35,0.025); color: #191a23; }
  .add-mod-btn {
    width: 100%; padding: 0.75rem;
    border: 1.5px dashed rgba(25,26,35,0.18); border-radius: 14px;
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    font-size: 0.8125rem; color: rgba(25,26,35,0.35);
    cursor: pointer; background: none; transition: all 0.15s; margin-top: 0.5rem;
  }
  .add-mod-btn:hover { border-color: rgba(25,26,35,0.4); color: #191a23; }

  /* Modal (substitui prompt/confirm nativos) */
  .dlg-overlay {
    position: fixed; inset: 0; background: rgba(25,26,35,0.5);
    display: none; align-items: center; justify-content: center;
    z-index: 200; padding: 1rem;
  }
  .dlg-overlay.show { display: flex; }
  .dlg-box {
    background: white; border-radius: 20px; padding: 1.5rem;
    width: 100%; max-width: 380px;
    border: 1.5px solid #191a23; box-shadow: 0px 8px 0px #191a23;
  }
  .dlg-title { font-size: 1.0625rem; font-weight: 600; margin-bottom: 0.25rem; }
  .dlg-msg { font-size: 0.875rem; color: rgba(25,26,35,0.55); margin: 0.25rem 0 0; }
  .dlg-box input.input { margin-top: 0.875rem; }
  .dlg-actions { display: flex; gap: 0.5rem; margin-top: 1.25rem; }
  .dlg-actions .btn-danger {
    flex: 1; font-size: 0.875rem;
    background: #ef4444; color: white; border: 1.5px solid #dc2626;
    border-radius: 8px; padding: 0.6rem 1.25rem; font-weight: 500;
    cursor: pointer; transition: all 0.15s;
  }
  .dlg-actions .btn-danger:hover { background: #dc2626; transform: scale(1.03); }

  /* Botões sutis de editar/excluir (aparecem mais claros no hover da linha) */
  .row-actions { display: flex; align-items: center; gap: 0.125rem; opacity: 0.45; transition: opacity 0.15s; }
  .mod-header:hover .row-actions, .aula-row:hover .row-actions { opacity: 1; }
  .row-act-btn {
    padding: 0.3rem; border-radius: 6px; background: none; border: none; cursor: pointer;
    color: rgba(25,26,35,0.5); transition: all 0.1s; flex-shrink: 0;
  }
  .row-act-btn:hover { color: #191a23; background: rgba(25,26,35,0.08); }
  .row-act-btn.danger:hover { color: #ef4444; background: rgba(239,68,68,0.1); }

  /* Menu de opções do curso (três pontos) */
  .hdr-menu-wrap { position: absolute; top: 1.1rem; right: 1.25rem; }
  .hdr-menu-btn {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; color: rgba(25,26,35,0.4);
    transition: all 0.15s;
  }
  .hdr-menu-btn:hover { background: rgba(25,26,35,0.06); color: #191a23; }
  .hdr-menu {
    position: absolute; top: calc(100% + 4px); right: 0;
    background: white; border: 1.5px solid #191a23; border-radius: 12px;
    box-shadow: 0px 4px 0px #191a23; min-width: 170px; padding: 0.35rem;
    display: none; z-index: 50;
  }
  .hdr-menu.show { display: block; }
  .hdr-menu-item {
    display: flex; align-items: center; gap: 0.55rem; width: 100%;
    padding: 0.55rem 0.65rem; border-radius: 8px; border: none; background: none;
    font-size: 0.8125rem; font-weight: 500; color: #191a23; cursor: pointer; text-align: left;
    transition: background 0.1s;
  }
  .hdr-menu-item:hover { background: rgba(25,26,35,0.06); }
  .hdr-menu-item.danger { color: #ef4444; }
  .hdr-menu-item.danger:hover { background: rgba(239,68,68,0.08); }

  /* Modal de edição do curso */
  .overlay { position: fixed; inset: 0; background: rgba(25,26,35,0.5); display: none; align-items: center; justify-content: center; z-index: 150; padding: 1rem; overflow-y: auto; }
  .overlay.show { display: flex; }
  .modal { background: white; border-radius: 20px; padding: 1.75rem; width: 100%; max-width: 440px; border: 1.5px solid #191a23; box-shadow: 0px 8px 0px #191a23; }
  .color-dot { width: 24px; height: 24px; border-radius: 50%; border: 2.5px solid transparent; cursor: pointer; transition: transform 0.15s, border-color 0.15s; flex-shrink: 0; }
  .color-dot.sel { border-color: #191a23; transform: scale(1.18); }
  .upload-zone { border: 2px dashed rgba(25,26,35,0.15); border-radius: 14px; padding: 1.25rem; text-align: center; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .upload-zone:hover, .upload-zone.drag { border-color: #6366f1; background: rgba(99,102,241,0.04); }
  .capa-preview { height: 90px; border-radius: 10px; overflow: hidden; margin-bottom: 0.5rem; display: none; }
  .capa-preview img { width: 100%; height: 100%; object-fit: cover; }
</style>

<!-- Back -->
<a href="/cursos" class="inline-flex items-center gap-1.5 text-sm text-dark/45 hover:text-dark mb-5 transition-colors">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
  </svg>
  Cursos
</a>

<!-- Course header card -->
<div class="relative mb-6">
  <div id="curso-header" class="rounded-2xl overflow-hidden border-2 border-dark shadow-[0_4px_0_#191a23]"></div>
  <div class="hdr-menu-wrap">
    <button class="hdr-menu-btn" onclick="toggleCursoMenu(event)" title="Opções do curso">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 7a2 2 0 110-4 2 2 0 010 4zm0 7a2 2 0 110-4 2 2 0 010 4zm0 7a2 2 0 110-4 2 2 0 010 4z"/>
      </svg>
    </button>
    <div class="hdr-menu" id="curso-menu">
      <button class="hdr-menu-item" onclick="openEditCursoModal()">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
        </svg>
        Editar curso
      </button>
      <button class="hdr-menu-item" onclick="irParaImportar()">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Importar questões
      </button>
      <button class="hdr-menu-item danger" onclick="excluirCurso()">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
        </svg>
        Excluir curso
      </button>
    </div>
  </div>
</div>

<!-- Modules -->
<div id="modulos"></div>

<!-- Add module -->
<button id="btn-add-mod" class="add-mod-btn hidden">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
  </svg>
  Adicionar Módulo
</button>

<!-- Modal (substitui prompt/confirm nativos) -->
<div id="dlg-overlay" class="dlg-overlay">
  <div class="dlg-box">
    <h3 id="dlg-title" class="dlg-title"></h3>
    <p id="dlg-msg" class="dlg-msg hidden"></p>
    <input id="dlg-input" class="input hidden" type="text" />
    <div class="dlg-actions">
      <button id="dlg-cancel" class="btn-secondary flex-1 text-sm">Cancelar</button>
      <button id="dlg-ok" class="btn-primary flex-1 text-sm">OK</button>
    </div>
  </div>
</div>

<!-- Modal de edição do curso -->
<div id="edit-overlay" class="overlay">
  <div class="modal">
    <h2 class="text-lg font-semibold mb-4">Editar Curso</h2>
    <div class="flex flex-col gap-4">
      <div>
        <label class="text-sm font-medium mb-1.5 block">Título <span class="text-red-400">*</span></label>
        <input id="edit-inp-titulo" type="text" class="input" placeholder="Ex: Cálculo I" />
      </div>
      <div>
        <label class="text-sm font-medium mb-1.5 block">Concurso <span class="text-dark/30 font-normal">(opcional)</span></label>
        <select id="edit-inp-concurso" class="input text-sm"><option value="">Geral (sem concurso)</option></select>
      </div>
      <div>
        <label class="text-sm font-medium mb-1.5 block">Descrição <span class="text-dark/30 font-normal">(opcional)</span></label>
        <textarea id="edit-inp-desc" class="input resize-none" rows="2" placeholder="Breve descrição…"></textarea>
      </div>
      <div>
        <label class="text-sm font-medium mb-2 block">Capa do curso</label>
        <div class="capa-preview" id="edit-capa-preview"><img id="edit-capa-img" src="" alt="" /></div>
        <div class="upload-zone" id="edit-upload-zone">
          <input type="file" id="edit-inp-capa" accept="image/*" class="hidden" />
          <svg class="w-7 h-7 text-dark/20 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M13.5 12h.008v.008H13.5V12zm-6 3h12a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75v8.25A2.25 2.25 0 004.5 15.75h3z"/>
          </svg>
          <p id="edit-upload-label" class="text-sm text-dark/40">Clique ou arraste uma imagem</p>
          <p class="text-xs text-dark/25 mt-0.5">JPG, PNG, WEBP · redimensionado automaticamente</p>
        </div>
        <div class="flex items-center gap-2 mt-2.5">
          <span class="text-xs text-dark/40 shrink-0">Cor (sem imagem):</span>
          <div class="flex gap-1.5 flex-wrap" id="edit-color-picker">
            <button class="color-dot sel" data-c="#6366f1" style="background:#6366f1" title="Índigo"></button>
            <button class="color-dot" data-c="#0ea5e9" style="background:#0ea5e9" title="Azul"></button>
            <button class="color-dot" data-c="#10b981" style="background:#10b981" title="Verde"></button>
            <button class="color-dot" data-c="#f59e0b" style="background:#f59e0b" title="Âmbar"></button>
            <button class="color-dot" data-c="#ef4444" style="background:#ef4444" title="Vermelho"></button>
            <button class="color-dot" data-c="#8b5cf6" style="background:#8b5cf6" title="Roxo"></button>
            <button class="color-dot" data-c="#191a23" style="background:#191a23" title="Escuro"></button>
          </div>
        </div>
      </div>
      <div class="flex gap-2 mt-2">
        <button id="edit-btn-cancel" class="btn-secondary flex-1 text-sm">Cancelar</button>
        <button id="edit-btn-salvar" class="btn-primary flex-1 text-sm">Salvar</button>
      </div>
    </div>
  </div>
</div>

<script>
  const token = localStorage.getItem('gab_token');
  const id = new URLSearchParams(location.search).get('id');
  if (!id) location.href = '/cursos';

  let curso: any = null;

  // ── Modal custom (substitui prompt/confirm nativos) ──
  const dlgOverlay = document.getElementById('dlg-overlay') as HTMLElement;
  const dlgTitle   = document.getElementById('dlg-title') as HTMLElement;
  const dlgMsg     = document.getElementById('dlg-msg') as HTMLElement;
  const dlgInput   = document.getElementById('dlg-input') as HTMLInputElement;
  const dlgCancel  = document.getElementById('dlg-cancel') as HTMLButtonElement;
  const dlgOk      = document.getElementById('dlg-ok') as HTMLButtonElement;

  function askText(title: string, placeholder = '', defaultValue = ''): Promise<string | null> {
    return new Promise(resolve => {
      dlgTitle.textContent = title;
      dlgMsg.classList.add('hidden');
      dlgInput.classList.remove('hidden');
      dlgInput.value = defaultValue;
      dlgInput.placeholder = placeholder;
      dlgOk.textContent = 'OK';
      dlgOk.classList.remove('btn-danger');
      dlgOk.classList.add('btn-primary');
      dlgOverlay.classList.add('show');
      setTimeout(() => { dlgInput.focus(); dlgInput.select(); }, 50);

      const cleanup = () => {
        dlgOverlay.classList.remove('show');
        dlgCancel.removeEventListener('click', onCancel);
        dlgOk.removeEventListener('click', onOk);
        dlgInput.removeEventListener('keydown', onKey);
      };
      const onCancel = () => { cleanup(); resolve(null); };
      const onOk = () => { const v = dlgInput.value.trim(); cleanup(); resolve(v || null); };
      const onKey = (e: KeyboardEvent) => { if (e.key === 'Enter') onOk(); if (e.key === 'Escape') onCancel(); };

      dlgCancel.addEventListener('click', onCancel);
      dlgOk.addEventListener('click', onOk);
      dlgInput.addEventListener('keydown', onKey);
    });
  }

  function askConfirm(title: string, msg: string): Promise<boolean> {
    return new Promise(resolve => {
      dlgTitle.textContent = title;
      dlgMsg.textContent = msg;
      dlgMsg.classList.remove('hidden');
      dlgInput.classList.add('hidden');
      dlgOk.textContent = 'Excluir';
      dlgOk.classList.remove('btn-primary');
      dlgOk.classList.add('btn-danger');
      dlgOverlay.classList.add('show');

      const cleanup = () => {
        dlgOverlay.classList.remove('show');
        dlgCancel.removeEventListener('click', onCancel);
        dlgOk.removeEventListener('click', onOk);
      };
      const onCancel = () => { cleanup(); resolve(false); };
      const onOk = () => { cleanup(); resolve(true); };

      dlgCancel.addEventListener('click', onCancel);
      dlgOk.addEventListener('click', onOk);
    });
  }

  async function load() {
    const res = await fetch(`/api/cursos/${id}`, { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) { location.href = '/cursos'; return; }
    curso = await res.json();
    render();
  }

  function render() {
    document.title = `${curso.titulo} · Gabarita`;
    (window as any).setBreadcrumb?.(['Gabarita', curso.titulo]);

    // Stats
    let total = 0, done = 0;
    for (const m of curso.modulos) { total += m.aulas.length; done += m.aulas.filter((a: any) => a.concluida).length; }
    const pct = total > 0 ? Math.round(done / total * 100) : 0;

    // Header (sem banner — só título/descrição + progresso)
    document.getElementById('curso-header')!.innerHTML = `
      <div class="px-6 py-5 bg-white">
        <h1 class="text-dark text-xl font-semibold pr-8">${curso.titulo}</h1>
        ${curso.descricao ? `<p class="text-dark/50 text-sm mt-1">${curso.descricao}</p>` : ''}
      </div>
      <div class="bg-white px-6 py-3 flex items-center gap-4 border-t border-dark/8">
        <div class="flex-1 h-2 rounded-full overflow-hidden" style="background:rgba(25,26,35,0.07)">
          <div class="h-full bg-green rounded-full transition-all" style="width:${pct}%"></div>
        </div>
        <span class="text-sm text-dark/50 shrink-0 font-medium">${done}/${total} aulas</span>
      </div>`;

    // Modules
    document.getElementById('modulos')!.innerHTML = curso.modulos.map((m: any) => `
      <div class="module-block" id="mod-${m.id}">
        <div class="mod-header" onclick="toggleMod(${m.id})">
          <svg class="chevron" id="chv-${m.id}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
          <span class="font-medium text-sm flex-1 truncate">${m.titulo}</span>
          <span class="text-xs text-dark/30 shrink-0">${m.aulas.length}a</span>
          <div class="row-actions">
            <button onclick="event.stopPropagation(); renameMod(${m.id})" class="row-act-btn" title="Renomear módulo">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
              </svg>
            </button>
            <button onclick="event.stopPropagation(); delMod(${m.id})" class="row-act-btn danger" title="Excluir módulo">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>
        <div id="aulas-${m.id}">
          ${m.aulas.map((a: any) => `
            <a href="/aula?id=${a.id}" class="aula-row">
              <div class="check-ring ${a.concluida ? 'done' : ''}">
                ${a.concluida ? `<svg class="w-3 h-3" style="color:#191a23" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>` : ''}
              </div>
              <span class="text-sm flex-1">${a.titulo}</span>
              ${a.duracao_min ? `<span class="text-xs text-dark/30">${a.duracao_min}min</span>` : ''}
              <div class="row-actions">
                <button onclick="event.preventDefault(); event.stopPropagation(); renameAula(${a.id})" class="row-act-btn" title="Renomear aula">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
                  </svg>
                </button>
                <button onclick="event.preventDefault(); event.stopPropagation(); delAula(${a.id})" class="row-act-btn danger" title="Excluir aula">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <svg class="w-4 h-4 text-dark/20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>`).join('')}
          <button class="add-aula-btn" onclick="addAula(${m.id})">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Nova aula
          </button>
        </div>
      </div>`).join('');

    document.getElementById('btn-add-mod')!.classList.remove('hidden');
  }

  function toggleMod(mid: number) {
    const aulas = document.getElementById(`aulas-${mid}`) as HTMLElement;
    const chv = document.getElementById(`chv-${mid}`) as HTMLElement;
    const hidden = aulas.style.display === 'none';
    aulas.style.display = hidden ? '' : 'none';
    chv.classList.toggle('closed', !hidden);
  }

  async function addAula(mid: number) {
    const titulo = await askText('Título da aula', 'Ex: Introdução ao tema');
    if (!titulo) return;
    const res = await fetch(`/api/cursos/modulos/${mid}/aulas`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo: titulo.trim() }),
    });
    if (res.ok) {
      const { id: aid } = await res.json();
      location.href = `/aula?id=${aid}`;
    }
  }

  async function delMod(mid: number) {
    const ok = await askConfirm('Remover módulo?', 'O módulo e todas as suas aulas serão apagados permanentemente.');
    if (!ok) return;
    await fetch(`/api/cursos/modulos/${mid}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
    load();
  }

  async function renameMod(mid: number) {
    const mod = curso.modulos.find((m: any) => m.id === mid);
    const titulo = await askText('Renomear módulo', 'Título do módulo', mod?.titulo || '');
    if (!titulo) return;
    await fetch(`/api/cursos/modulos/${mid}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo: titulo.trim() }),
    });
    load();
  }

  async function renameAula(aid: number) {
    let atual = '';
    for (const m of curso.modulos) {
      const a = m.aulas.find((x: any) => x.id === aid);
      if (a) { atual = a.titulo; break; }
    }
    const titulo = await askText('Renomear aula', 'Título da aula', atual);
    if (!titulo) return;
    await fetch(`/api/cursos/aulas/${aid}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo: titulo.trim() }),
    });
    load();
  }

  async function delAula(aid: number) {
    const ok = await askConfirm('Excluir aula?', 'Esta aula e todo o seu conteúdo serão apagados permanentemente.');
    if (!ok) return;
    await fetch(`/api/cursos/aulas/${aid}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
    load();
  }

  document.getElementById('btn-add-mod')!.addEventListener('click', async () => {
    const titulo = await askText('Título do módulo', 'Ex: Módulo 1 — Introdução');
    if (!titulo) return;
    await fetch(`/api/cursos/${id}/modulos`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo: titulo.trim() }),
    });
    load();
  });

  (window as any).toggleMod = toggleMod;
  (window as any).addAula = addAula;
  (window as any).delMod = delMod;
  (window as any).renameMod = renameMod;
  (window as any).renameAula = renameAula;
  (window as any).delAula = delAula;

  // ── Menu de opções do curso (três pontos) ──
  function toggleCursoMenu(e: Event) {
    e.stopPropagation();
    document.getElementById('curso-menu')?.classList.toggle('show');
  }
  document.addEventListener('click', e => {
    const menu = document.getElementById('curso-menu');
    if (menu && menu.classList.contains('show') && !(e.target as HTMLElement).closest('.hdr-menu-wrap')) {
      menu.classList.remove('show');
    }
  });

  async function excluirCurso() {
    document.getElementById('curso-menu')?.classList.remove('show');
    const ok = await askConfirm('Excluir curso?', 'O curso, seus módulos e aulas serão apagados permanentemente.');
    if (!ok) return;
    await fetch(`/api/cursos/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
    location.href = '/cursos';
  }

  function irParaImportar() {
    document.getElementById('curso-menu')?.classList.remove('show');
    location.href = `/importar?curso_id=${id}`;
  }

  // ── Modal de edição do curso ──
  let editCor = '#6366f1';
  let editCapaBase64: string | null = null;

  const editOverlay = document.getElementById('edit-overlay') as HTMLElement;

  function compressImage(file: File): Promise<string> {
    return new Promise(resolve => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        const MAX = 800;
        let { width, height } = img;
        if (width > MAX) { height = Math.round(height * MAX / width); width = MAX; }
        const canvas = document.createElement('canvas');
        canvas.width = width; canvas.height = height;
        canvas.getContext('2d')!.drawImage(img, 0, 0, width, height);
        URL.revokeObjectURL(url);
        resolve(canvas.toDataURL('image/jpeg', 0.7));
      };
      img.src = url;
    });
  }
  async function processEditImage(file: File) {
    const b64 = await compressImage(file);
    editCapaBase64 = b64;
    (document.getElementById('edit-capa-img') as HTMLImageElement).src = b64;
    (document.getElementById('edit-capa-preview') as HTMLElement).style.display = 'block';
    (document.getElementById('edit-upload-label') as HTMLElement).textContent = file.name;
  }
  const editInpCapa = document.getElementById('edit-inp-capa') as HTMLInputElement;
  const editUploadZone = document.getElementById('edit-upload-zone')!;
  editUploadZone.addEventListener('click', () => editInpCapa.click());
  editUploadZone.addEventListener('dragover', e => { e.preventDefault(); editUploadZone.classList.add('drag'); });
  editUploadZone.addEventListener('dragleave', () => editUploadZone.classList.remove('drag'));
  editUploadZone.addEventListener('drop', async (e: DragEvent) => {
    e.preventDefault(); editUploadZone.classList.remove('drag');
    const file = e.dataTransfer?.files[0]; if (file) await processEditImage(file);
  });
  editInpCapa.addEventListener('change', async () => { const file = editInpCapa.files?.[0]; if (file) await processEditImage(file); });

  document.getElementById('edit-color-picker')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.color-dot');
    if (!btn) return;
    document.querySelectorAll('#edit-color-picker .color-dot').forEach(el => el.classList.remove('sel'));
    btn.classList.add('sel');
    editCor = btn.dataset.c!;
  });

  function openEditCursoModal() {
    document.getElementById('curso-menu')?.classList.remove('show');
    editCor = curso.cor || '#6366f1';
    editCapaBase64 = curso.capa_base64 || null;
    (document.getElementById('edit-inp-titulo') as HTMLInputElement).value = curso.titulo || '';
    (document.getElementById('edit-inp-concurso') as HTMLSelectElement).value = curso.concurso_id ? String(curso.concurso_id) : '';
    (document.getElementById('edit-inp-desc') as HTMLTextAreaElement).value = curso.descricao || '';
    document.querySelectorAll<HTMLElement>('#edit-color-picker .color-dot').forEach(el => el.classList.toggle('sel', el.dataset.c === editCor));
    if (editCapaBase64) {
      (document.getElementById('edit-capa-img') as HTMLImageElement).src = editCapaBase64;
      (document.getElementById('edit-capa-preview') as HTMLElement).style.display = 'block';
      (document.getElementById('edit-upload-label') as HTMLElement).textContent = 'Capa atual (clique para trocar)';
    } else {
      (document.getElementById('edit-capa-preview') as HTMLElement).style.display = 'none';
      (document.getElementById('edit-upload-label') as HTMLElement).textContent = 'Clique ou arraste uma imagem';
    }
    editOverlay.classList.add('show');
  }

  function closeEditModal() {
    editOverlay.classList.remove('show');
  }
  editOverlay.addEventListener('click', e => { if (e.target === editOverlay) closeEditModal(); });
  document.getElementById('edit-btn-cancel')!.addEventListener('click', closeEditModal);

  document.getElementById('edit-btn-salvar')!.addEventListener('click', async () => {
    const titulo = (document.getElementById('edit-inp-titulo') as HTMLInputElement).value.trim();
    const descricao = (document.getElementById('edit-inp-desc') as HTMLTextAreaElement).value.trim();
    const concursoId = (document.getElementById('edit-inp-concurso') as HTMLSelectElement).value || null;
    if (!titulo) { (document.getElementById('edit-inp-titulo') as HTMLInputElement).focus(); return; }
    const btn = document.getElementById('edit-btn-salvar') as HTMLButtonElement;
    btn.textContent = 'Salvando…'; btn.disabled = true;
    const res = await fetch(`/api/cursos/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ titulo, descricao, cor: editCor, capa_base64: editCapaBase64, concurso_id: concursoId }),
    });
    btn.textContent = 'Salvar'; btn.disabled = false;
    if (res.ok) { closeEditModal(); load(); }
  });

  (window as any).toggleCursoMenu = toggleCursoMenu;
  (window as any).openEditCursoModal = openEditCursoModal;
  (window as any).excluirCurso = excluirCurso;
  (window as any).irParaImportar = irParaImportar;

  async function loadConcursosSelect() {
    const res = await fetch('/api/concursos');
    const concursos = res.ok ? await res.json() : [];
    (document.getElementById('edit-inp-concurso') as HTMLSelectElement).innerHTML =
      '<option value="">Geral (sem concurso)</option>' +
      concursos.map((c: any) => `<option value="${c.id}">${c.nome}</option>`).join('');
  }

  load();
  loadConcursosSelect();
</script>
</MainLayout>
