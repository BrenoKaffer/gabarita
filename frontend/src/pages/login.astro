---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Login" showNav={false}>
<style>
  .login-wrap {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 768px) {
    .login-wrap { grid-template-columns: 1fr; }
    .login-brand { display: none; }
  }

  .login-brand {
    background: #191a23;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
  }
  .login-brand::before {
    content: '';
    position: absolute;
    top: -120px; right: -120px;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(185,255,102,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .login-brand::after {
    content: '';
    position: absolute;
    bottom: -80px; left: -80px;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(185,255,102,0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .login-form-side {
    background: #f3f3f3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 2rem;
  }
</style>

<div class="login-wrap">

  <!-- Lado esquerdo — branding -->
  <div class="login-brand">
    <div>
      <img src="/logo_gabarita_escuro.png" alt="Gabarita" class="h-14 w-auto mb-10" style="mix-blend-mode:lighten" />
      <h1 class="text-white text-4xl font-semibold leading-tight mb-4">
        Prepare-se para<br/>
        <span style="color:#b9ff66">passar de primeira.</span>
      </h1>
      <p class="text-white/50 text-base leading-relaxed max-w-xs">
        Questões reais, simulados cronometrados e análise de erros, tudo em um só lugar.
      </p>
    </div>

    <div class="flex flex-col gap-4 relative z-10">
      <p class="text-white/25 text-xs">
        © 2026 Gabarita · Todos os direitos reservados
      </p>
    </div>
  </div>

  <!-- Lado direito — formulário -->
  <div class="login-form-side">
    <div class="w-full max-w-sm">

      <!-- Mobile logo -->
      <div class="flex justify-center mb-8 md:hidden">
        <img src="/logo_gabarita_escuro.png" alt="Gabarita" class="h-12 w-auto" />
      </div>

      <h2 class="text-2xl font-semibold text-dark mb-1">Entrar na conta</h2>
      <p class="text-dark/50 text-sm mb-8">Use seu e-mail e senha para acessar</p>

      <div id="error-msg"
        class="hidden mb-5 bg-red-50 border border-red-200 text-red-700 rounded-btn px-4 py-3 text-sm flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span id="error-text"></span>
      </div>

      <form id="login-form" class="flex flex-col gap-5" method="post" action="#" onsubmit="return false">
        <div>
          <label class="text-sm font-medium mb-1.5 block text-dark">E-mail</label>
          <input name="email" type="email" required class="input" placeholder="seu@email.com"
            autocomplete="email" />
        </div>
        <div>
          <label class="text-sm font-medium mb-1.5 block text-dark">Senha</label>
          <input name="password" type="password" required class="input" placeholder="••••••••"
            autocomplete="current-password" />
        </div>
        <button type="submit" id="btn-submit" class="btn-primary w-full mt-1">
          <span id="btn-label">Entrar</span>
          <span id="btn-loading" class="hidden">Entrando…</span>
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-dark/10 text-center">
        <p class="text-sm text-dark/50">
          Não tem conta?
          <a href="/register" class="text-dark font-medium underline underline-offset-2 hover:text-green transition-colors">
            Criar conta grátis
          </a>
        </p>
      </div>

    </div>
  </div>

</div>
</MainLayout>

<script>
  const form    = document.getElementById('login-form') as HTMLFormElement;
  const errEl   = document.getElementById('error-msg') as HTMLElement;
  const errText = document.getElementById('error-text') as HTMLElement;
  const btnLabel   = document.getElementById('btn-label') as HTMLElement;
  const btnLoading = document.getElementById('btn-loading') as HTMLElement;

  // Já logado → redireciona direto
  if (localStorage.getItem('gab_token')) location.href = '/home';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.classList.add('hidden');
    btnLabel.classList.add('hidden');
    btnLoading.classList.remove('hidden');

    const data = Object.fromEntries(new FormData(form));
    try {
      const res  = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (!res.ok) {
        errText.textContent = json.error || 'Erro ao entrar.';
        errEl.classList.remove('hidden');
        return;
      }
      localStorage.setItem('gab_token', json.token);
      localStorage.setItem('gab_user', JSON.stringify(json.user));
      location.href = '/home';
    } catch {
      errText.textContent = 'Sem conexão com o servidor.';
      errEl.classList.remove('hidden');
    } finally {
      btnLabel.classList.remove('hidden');
      btnLoading.classList.add('hidden');
    }
  });
</script>
